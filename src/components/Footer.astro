---
import site from '../data/site.json';
import { getLocale, t, localePath } from '../lib/i18n';

const locale = getLocale(Astro.url.pathname);
const ui = t(locale);
const lp = (p = '') => localePath(locale, p);
const locations = locale === 'en' && site.locationsEn
  ? site.locationsEn.map((loc, i) => ({
      name: loc.name,
      address: loc.address,
      phone: loc.phone || site.locations[i]?.phone,
    }))
  : site.locations;
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <h3>{ui.quickLinks}</h3>
      <a href={lp()}>{ui.home}</a>
      <a href={lp('services')}>{ui.services}</a>
      <a href={lp('doctors')}>{ui.doctors}</a>
      <a href={lp('education')}>{ui.education}</a>
      <a href={lp('about')}>{ui.about}</a>
      <a href={lp('contact')}>{ui.contactNav}</a>
    </div>
    <div>
      <h3>{ui.contactUs}</h3>
      <p class="label">{ui.hours}</p>
      {locations.map((loc, i) => {
        const rows = locale === 'en'
          ? (site.locations[i]?.hoursRowsEn || site.locations[i]?.hoursRows)
          : site.locations[i]?.hoursRows;
        return (
          <p>
            <strong>{loc.name}</strong><br />
            {(rows || []).map((row) => (
              <>{row.days} {row.time}<br /></>
            ))}
          </p>
        );
      })}
      <p class="label">{ui.address}</p>
      {locations.map((loc) => (
        <p>
          <strong>{loc.name}</strong><br />
          {loc.address}<br />
          {loc.phone}
        </p>
      ))}
    </div>
    <div class="cta">
      <h3>{ui.contactCta}</h3>
      <p>{ui.contactCtaLead}</p>
      <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
        <img src="/assets/whatsapp.svg" alt="" />
        {ui.bookWhatsapp}
      </a>
      {site.qrCode && (
        <div class="qr">
          <img src={site.qrCode} alt="WeChat QR" />
          <span>{ui.wechatQr}</span>
        </div>
      )}
    </div>
  </div>
  <div class="container copy">
    <span>© 2026 {locale === 'en' ? site.nameEn : site.name}</span>
    <nav aria-label={locale === 'en' ? 'Legal' : '法律資訊'}>
      <a href={lp('disclaimer')}>{locale === 'en' ? 'Disclaimer & Privacy' : '免責聲明及私隱政策'}</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: 0;
    background: var(--cyan);
    color: #fff;
    padding: 52px 0 28px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    gap: 36px;
  }
  .footer h3 { margin: 0 0 14px; font-size: 16px; font-weight: 700; }
  .footer a, .footer p { display: block; margin: 0 0 10px; font-size: 14px; line-height: 1.55; opacity: .96; }
  .footer a:hover { opacity: 1; text-decoration: underline; }
  .label {
    margin: 14px 0 6px !important;
    font-size: 12px !important;
    letter-spacing: .04em;
    opacity: .75 !important;
    font-weight: 600;
  }
  .label:first-of-type { margin-top: 0 !important; }
  .cta .wa-btn { margin-top: 10px; color: #111; }
  .qr {
    display: flex; align-items: center; gap: 12px;
    margin-top: 16px;
  }
  .qr img {
    width: 72px; height: 72px; border-radius: 10px; background: #fff; object-fit: cover;
  }
  .qr span { font-size: 13px; opacity: .9; max-width: 8em; line-height: 1.4; }
  .copy {
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,.25);
    font-size: 13px;
    opacity: .9;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
  }
  .copy nav { display: flex; gap: 16px; }
  .copy a { margin: 0; opacity: .9; }
  @media (max-width: 800px) {
    .footer { padding: 40px 0 24px; }
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
    .cta .wa-btn { width: 100%; }
  }
</style>
