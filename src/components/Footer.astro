---
import site from '../data/site.json';
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <h3>快速鏈接</h3>
      <a href="/zh/">首頁</a>
      <a href="/zh/services/">兒科服務</a>
      <a href="/zh/doctors/">醫生團隊</a>
      <a href="/zh/education/">兒科教育</a>
      <a href="/zh/contact/">關於我們</a>
    </div>
    <div>
      <h3>聯絡我們</h3>
      <p class="label">營業時間</p>
      <p>{site.hours}</p>
      <p class="label">診所地址</p>
      {site.locations.map((loc) => (
        <p>
          <strong>{loc.name}</strong><br />
          {loc.address}<br />
          {loc.phone}
        </p>
      ))}
    </div>
    <div class="cta">
      <h3>馬上聯絡我們</h3>
      <p>我們的團隊隨時準備為您提供幫助</p>
      <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
        <img src="/assets/whatsapp.svg" alt="" />
        WhatsApp 預約
      </a>
      {site.qrCode && (
        <div class="qr">
          <img src={site.qrCode} alt="微信二維碼" />
          <span>請用微信掃碼關注</span>
        </div>
      )}
    </div>
  </div>
  <div class="container copy">
    <span>© 2026 {site.name}</span>
    <nav aria-label="法律資訊">
      <a href="/zh/disclaimer/">服務條款</a>
      <a href="/zh/disclaimer/">用戶隱私</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: 0;
    background: var(--cyan);
    color: #fff;
    padding: 52px 0 28px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    gap: 36px;
  }
  .footer h3 { margin: 0 0 14px; font-size: 16px; font-weight: 700; }
  .footer a, .footer p { display: block; margin: 0 0 10px; font-size: 14px; line-height: 1.55; opacity: .96; }
  .footer a:hover { opacity: 1; text-decoration: underline; }
  .label {
    margin: 14px 0 6px !important;
    font-size: 12px !important;
    letter-spacing: .04em;
    opacity: .75 !important;
    font-weight: 600;
  }
  .label:first-of-type { margin-top: 0 !important; }
  .cta .wa-btn { margin-top: 10px; color: #111; }
  .qr {
    display: flex; align-items: center; gap: 12px;
    margin-top: 16px;
  }
  .qr img {
    width: 72px; height: 72px; border-radius: 10px; background: #fff; object-fit: cover;
  }
  .qr span { font-size: 13px; opacity: .9; max-width: 8em; line-height: 1.4; }
  .copy {
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,.25);
    font-size: 13px;
    opacity: .9;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
  }
  .copy nav { display: flex; gap: 16px; }
  .copy a { margin: 0; opacity: .9; }
  @media (max-width: 800px) {
    .footer { padding: 40px 0 24px; }
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
    .cta .wa-btn { width: 100%; }
  }
</style>
