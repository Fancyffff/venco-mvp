---
import services from '../data/services.json';
import doctors from '../data/doctors.json';
import education from '../data/education.json';
import educationCategories from '../data/education-categories.json';
import site from '../data/site.json';

const path = Astro.url.pathname;
const isHome = path === '/zh/' || path === '/zh';
const departmentOrder = [
  'general',
  'respiratory',
  'endocrine',
  'genetics',
  'surgery',
  'neuro',
  'obstetrics',
  'psychology',
];
const doctorGroups = departmentOrder
  .map((id) => {
    const list = doctors.filter((d) => d.department === id);
    if (!list.length) return null;
    return { id, title: list[0].departmentTitle, doctors: list };
  })
  .filter(Boolean);

const eduGroups = educationCategories
  .map((c) => {
    const articles = education.filter((a) => a.category === c.id);
    if (!articles.length) return null;
    return { ...c, articles };
  })
  .filter(Boolean);
---
<header class="header">
  <div class="container header-inner">
    <a class="logo" href="/zh/" aria-label="榛怡醫務中心首頁">
      <img src="/assets/logo.png" alt={site.name} />
    </a>

    <nav class="nav" aria-label="主導航">
      <a class:list={['nav-link', { active: isHome }]} href="/zh/">首頁</a>

      <div class="nav-item has-menu">
        <a class:list={['nav-link', { active: path.includes('/services') }]} href="/zh/services/">
          兒科服務 <span class="caret" aria-hidden="true"></span>
        </a>
        <div class="mega" role="menu" aria-label="兒科服務選單">
          <div class="mega-cols">
            <div class="mega-l2">
              <p class="mega-label">服務分類</p>
              {services.map((s, i) => (
                <a
                  class:list={['mega-l2-item', { 'is-active': i === 0 }]}
                  href={`/zh/services/${s.id}/`}
                  data-panel={s.id}
                >
                  <img src={s.icon} alt="" width="28" height="28" />
                  <span>{s.title}</span>
                </a>
              ))}
            </div>
            <div class="mega-l3">
              <p class="mega-label">服務細項 / 相關醫生</p>
              {services.map((s, i) => (
                <div class:list={['l3-panel', { show: i === 0 }]} data-l3={s.id}>
                  <a class="l3-title" href={`/zh/services/${s.id}/`}>{s.title} · 查看專科</a>
                  {s.items.length > 0 ? (
                    <ul class="l3-list">
                      {s.items.map((item) => (
                        <li>
                          <a href={`/zh/services/${s.id}/${item.slug}/`}>{item.text}</a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="l3-empty">暫無細項列表，請進入專科頁了解詳情</p>
                  )}
                  {s.doctorIds.length > 0 && (
                    <div class="l3-doctors">
                      <p class="mega-label">相關醫生</p>
                      <div class="l3-doctor-list">
                        {s.doctorIds.map((id) => {
                          const d = doctors.find((x) => x.id === id);
                          if (!d) return null;
                          return (
                            <a href={`/zh/doctors/${d.department}/#${d.id}`}>
                              <img src={d.image} alt={d.name} />
                              <span>{d.name}</span>
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="nav-item has-menu">
        <a class:list={['nav-link', { active: path.includes('/doctors') }]} href="/zh/doctors/">
          醫生團隊 <span class="caret" aria-hidden="true"></span>
        </a>
        <div class="mega mega-doctors" role="menu" aria-label="醫生團隊選單">
          <div class="mega-cols">
            <div class="mega-l2">
              <p class="mega-label">科室分類</p>
              {doctorGroups.map((g, i) => (
                <a
                  class:list={['mega-l2-item', { 'is-active': i === 0 }]}
                  href={`/zh/doctors/${g.id}/`}
                  data-panel={g.id}
                >
                  <span>{g.title}</span>
                </a>
              ))}
            </div>
            <div class="mega-l3">
              <p class="mega-label">科室成員</p>
              {doctorGroups.map((g, i) => (
                <div class:list={['l3-panel', { show: i === 0 }]} data-l3={g.id}>
                  <a class="l3-title" href={`/zh/doctors/${g.id}/`}>{g.title} · 查看科室</a>
                  <ul class="l3-list doctors">
                    {g.doctors.map((d) => (
                      <li>
                        <a href={`/zh/doctors/${g.id}/#${d.id}`}>
                          <img src={d.image} alt="" />
                          <span>
                            <strong>{d.name}</strong>
                            <small>{d.title}</small>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="nav-item has-menu">
        <a class:list={['nav-link', { active: path.includes('/education') }]} href="/zh/education/">
          兒科教育 <span class="caret" aria-hidden="true"></span>
        </a>
        <div class="mega mega-edu" role="menu" aria-label="兒科教育選單">
          <div class="mega-cols">
            <div class="mega-l2">
              <p class="mega-label">主題分類</p>
              {eduGroups.map((g, i) => (
                <a
                  class:list={['mega-l2-item', { first: i === 0 }]}
                  href={`/zh/education/${g.id}/`}
                  data-panel={g.id}
                >
                  <span>{g.title}</span>
                </a>
              ))}
            </div>
            <div class="mega-l3">
              <p class="mega-label">分類文章</p>
              {eduGroups.map((g, i) => (
                <div class:list={['l3-panel', { show: i === 0 }]} data-l3={g.id}>
                  <a class="l3-title" href={`/zh/education/${g.id}/`}>{g.title} · 查看全部</a>
                  <ul class="l3-list">
                    {g.articles.slice(0, 8).map((a) => (
                      <li>
                        <a href={`/zh/education/${g.id}/${a.slug}/`}>{a.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <a class:list={['nav-link', { active: path.includes('/contact') }]} href="/zh/contact/">關於我們</a>
    </nav>

    <div class="actions">
      <div class="lang-desk">
        <button type="button" class="lang-trigger" aria-haspopup="true">繁體中文</button>
      </div>
      <a class="wa-btn header-wa" href={site.whatsapp} target="_blank" rel="noreferrer">
        <img src="/assets/whatsapp.svg" alt="" />
        <span class="wa-text">WhatsApp 預約</span>
      </a>
      <button class="mobile-toggle" type="button" data-mobile-open aria-label="打開選單" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-backdrop" data-mobile-backdrop hidden></div>
  <aside class="mobile-panel" data-mobile-drawer hidden>
    <div class="mobile-panel-top">
      <a class="logo" href="/zh/" aria-label="首頁">
        <img src="/assets/logo.png" alt={site.name} />
      </a>
      <button type="button" class="mobile-close" data-mobile-close aria-label="關閉">✕</button>
    </div>

    <nav class="mobile-nav" aria-label="手機選單">
      <a class:list={['m-link', { active: isHome }]} href="/zh/">首頁</a>

      <details class="m-acc">
        <summary class:list={[{ active: path.includes('/services') }]}>兒科服務</summary>
        <div class="m-sub">
          <a href="/zh/services/">服務總覽</a>
          {services.map((s) => (
            <a href={`/zh/services/${s.id}/`}>{s.title}</a>
          ))}
        </div>
      </details>

      <details class="m-acc">
        <summary class:list={[{ active: path.includes('/doctors') }]}>醫生團隊</summary>
        <div class="m-sub">
          <a href="/zh/doctors/">科室總覽</a>
          {doctorGroups.map((g) => (
            <a href={`/zh/doctors/${g.id}/`}>{g.title}</a>
          ))}
        </div>
      </details>

      <details class="m-acc">
        <summary class:list={[{ active: path.includes('/education') }]}>兒科教育</summary>
        <div class="m-sub">
          <a href="/zh/education/">主題總覽</a>
          {eduGroups.map((g) => (
            <a href={`/zh/education/${g.id}/`}>{g.title}</a>
          ))}
        </div>
      </details>

      <a class:list={['m-link', { active: path.includes('/contact') }]} href="/zh/contact/">關於我們</a>
    </nav>

    <div class="mobile-lang">
      <p>語言切換</p>
      <div class="lang-row">
        <span class="lang-chip active">繁體中文</span>
        <span class="lang-chip">简体中文</span>
        <span class="lang-chip">English</span>
      </div>
    </div>

    <a class="wa-btn mobile-wa" href={site.whatsapp} target="_blank" rel="noreferrer">
      <img src="/assets/whatsapp.svg" alt="" />
      WhatsApp 預約
    </a>
  </aside>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(217, 232, 236, 0.8);
  }
  .header-inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .logo { flex: 0 1 auto; min-width: 0; }
  .logo img { height: 44px; width: auto; max-width: min(210px, 48vw); object-fit: contain; }
  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
    margin-right: 12px;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    color: #444;
    font-size: 15px;
    font-weight: 500;
    transition: color .15s ease;
  }
  .nav-link:hover { color: var(--cyan); }
  .nav-link.active { color: var(--cyan); font-weight: 600; }
  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 2px;
    height: 3px;
    border-radius: 999px;
    background: var(--cyan);
  }
  .caret {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
    opacity: .65;
  }
  .nav-item { position: relative; }
  .mega {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-35%);
    width: min(860px, calc(100vw - 32px));
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 18px 50px rgba(0, 40, 50, 0.12);
    padding: 18px;
  }
  .mega::before {
    content: "";
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  .nav-item:hover .mega,
  .nav-item:focus-within .mega { display: block; }
  .mega-cols { display: grid; grid-template-columns: 280px 1fr; gap: 14px; min-height: 340px; }
  .mega-label {
    margin: 0 0 10px;
    font-size: 12px;
    color: #8a9aa0;
    letter-spacing: .04em;
    font-weight: 600;
  }
  .mega-l2 {
    border-right: 1px solid var(--line);
    padding-right: 14px;
    max-height: 440px;
    overflow: auto;
  }
  .mega-l2-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 14px;
    color: #333;
  }
  .mega-l2-item img { width: 28px; height: 28px; object-fit: contain; }
  .mega-l2-item:hover,
  .mega-l2-item.is-active { background: var(--cyan-soft); color: var(--cyan-hover); }
  .l3-panel { display: none; }
  .l3-panel.show { display: block; }
  .l3-title {
    display: inline-block;
    margin-bottom: 10px;
    color: var(--cyan);
    font-weight: 700;
    font-size: 14px;
  }
  .l3-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; max-height: 280px; overflow: auto; }
  .l3-list a {
    display: block;
    padding: 8px 10px;
    border-radius: 10px;
    font-size: 14px;
    color: #333;
  }
  .l3-list a:hover { background: var(--cyan-soft); color: var(--cyan-hover); }
  .l3-list.doctors a {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .l3-list.doctors img {
    width: 36px; height: 36px; border-radius: 50%; object-fit: cover;
  }
  .l3-list.doctors small { display: block; color: var(--muted); font-size: 12px; }
  .l3-empty { color: var(--muted); font-size: 13px; margin: 0; }
  .l3-doctors { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); }
  .l3-doctor-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .l3-doctor-list a {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 10px 6px 6px; border-radius: 999px; background: #f4fafb; font-size: 13px;
  }
  .l3-doctor-list img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
  .actions { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .lang-trigger {
    min-height: 36px;
    padding: 4px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #f7fafb;
    font-size: 13px;
    font-weight: 600;
    color: #333;
  }
  .mobile-toggle {
    display: none;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 12px;
    width: 42px; height: 42px;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .mobile-toggle span {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: #333;
  }
  .mobile-backdrop {
    position: fixed; inset: 0; z-index: 55;
    background: rgba(0,0,0,.28);
  }
  .mobile-backdrop[hidden],
  .mobile-panel[hidden] { display: none !important; }

  .mobile-panel {
    position: fixed;
    inset: 12px;
    z-index: 60;
    background: #fff;
    border-radius: 22px;
    padding: 18px 18px 24px;
    overflow: auto;
    box-shadow: 0 20px 60px rgba(0,30,40,.18);
    display: flex;
    flex-direction: column;
  }
  .mobile-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .mobile-panel-top .logo img { height: 40px; }
  .mobile-close {
    width: 40px; height: 40px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--cyan);
    font-size: 26px;
    line-height: 1;
  }
  .mobile-nav { display: grid; gap: 6px; flex: 1 1 auto; }
  .m-link, .m-acc > summary {
    display: block;
    padding: 14px 16px;
    border-radius: 14px;
    font-size: 18px;
    font-weight: 600;
    color: #222;
  }
  .m-link.active,
  .m-acc > summary.active {
    background: #dff7f9;
    color: #0f8a98;
  }
  .m-acc > summary {
    list-style: none;
    cursor: pointer;
  }
  .m-acc > summary::-webkit-details-marker { display: none; }
  .m-acc > summary::after {
    content: "▾";
    float: right;
    color: #99b4b8;
    font-size: 14px;
  }
  .m-acc[open] > summary::after { content: "▴"; }
  .m-sub {
    display: grid;
    gap: 2px;
    padding: 4px 8px 10px 12px;
  }
  .m-sub a {
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 15px;
    color: #445;
  }
  .m-sub a:hover { background: #f4fafb; color: var(--cyan); }
  .mobile-lang {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid #e8eef0;
  }
  .mobile-lang p {
    margin: 0 0 10px;
    font-size: 13px;
    color: #8a9aa0;
  }
  .lang-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .lang-chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 12px;
    background: #f1f5f6;
    color: #667;
    font-size: 13px;
    font-weight: 600;
  }
  .lang-chip.active {
    background: #dff7f9;
    color: #0f8a98;
  }
  .mobile-wa {
    margin-top: 20px;
    width: 100%;
    flex: 0 0 auto;
  }

  @media (max-width: 980px) {
    .nav { display: none; }
    .lang-desk { display: none; }
    .mobile-toggle { display: inline-flex; }
    .logo img { height: 36px; }
    .header-wa { min-width: 0; padding: 0 12px; }
  }
  @media (max-width: 420px) {
    .header-wa .wa-text { display: none; }
    .header-wa { width: 40px; height: 40px; min-height: 40px; padding: 0; border-radius: 12px; }
  }
</style>

<script>
  const openBtn = document.querySelector('[data-mobile-open]');
  const closeBtn = document.querySelector('[data-mobile-close]');
  const drawer = document.querySelector('[data-mobile-drawer]');
  const backdrop = document.querySelector('[data-mobile-backdrop]');

  const openDrawer = () => {
    drawer?.removeAttribute('hidden');
    backdrop?.removeAttribute('hidden');
    document.body.classList.add('drawer-open');
    openBtn?.setAttribute('aria-expanded', 'true');
  };
  const closeDrawer = () => {
    drawer?.setAttribute('hidden', '');
    backdrop?.setAttribute('hidden', '');
    document.body.classList.remove('drawer-open');
    openBtn?.setAttribute('aria-expanded', 'false');
  };

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));

  document.querySelectorAll('.mega').forEach((mega) => {
    const items = mega.querySelectorAll('.mega-l2-item');
    const panels = mega.querySelectorAll('.l3-panel');
    items.forEach((item) => {
      const activate = () => {
        const id = item.getAttribute('data-panel');
        items.forEach((x) => x.classList.toggle('is-active', x === item));
        panels.forEach((p) => p.classList.toggle('show', p.getAttribute('data-l3') === id));
      };
      item.addEventListener('mouseenter', activate);
      item.addEventListener('focus', activate);
    });
  });
</script>
