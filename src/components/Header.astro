---
import services from '../data/services.json';
import doctors from '../data/doctors.json';
import education from '../data/education.json';
import educationCategories from '../data/education-categories.json';
import site from '../data/site.json';
import { activeDepartments, deptTitleZh } from '../lib/departments';
import {
  getLocale,
  t,
  localePath,
  switchLocalePath,
  serviceTitle,
  deptTitleEn,
  categoryCopyEn,
} from '../lib/i18n';

const path = Astro.url.pathname;
const locale = getLocale(path);
const ui = t(locale);
const lp = (p = '') => localePath(locale, p);
const otherLocale = locale === 'en' ? 'zh' : 'en';
const otherHref = switchLocalePath(path, otherLocale);
const isHome = path === lp() || path === lp().replace(/\/$/, '');
const doctorGroups = activeDepartments().map(({ id, doctors: list }) => ({
  id,
  title: locale === 'en' ? deptTitleEn[id] || deptTitleZh(id) : deptTitleZh(id),
  doctors: list,
}));

const eduGroups = educationCategories
  .map((c) => {
    const articles = education.filter((a) => a.category === c.id);
    if (!articles.length) return null;
    const title = locale === 'en' ? (categoryCopyEn[c.id]?.title || c.title) : c.title;
    return { ...c, title, articles };
  })
  .filter(Boolean);
---
<header class:list={['header', `locale-${locale}`]}>
  <div class="container header-inner">
    <a class="logo" href={lp()} aria-label={locale === 'en' ? site.nameEn : site.name}>
      <img src="/assets/logo.png" alt={locale === 'en' ? site.nameEn : site.name} />
    </a>

    <nav class="nav" aria-label={locale === 'en' ? 'Main' : '主導航'}>
      <div class="nav-item has-menu">
        <a class:list={['nav-link', { active: isHome || path.includes('/about') }]} href={lp()}>
          {ui.home} <span class="caret" aria-hidden="true"></span>
        </a>
        <div class="mega mega-simple" role="menu" aria-label={ui.home}>
          <a href={lp()}>{ui.home}</a>
          <a href={`${lp('about')}#about`}>{ui.about}</a>
          <a href={`${lp('about')}#environment`}>{ui.clinicEnv}</a>
        </div>
      </div>

      <div class="nav-item has-menu">
        <a class:list={['nav-link', { active: path.includes('/services') }]} href={lp("services")}>
          {ui.services} <span class="caret" aria-hidden="true"></span>
        </a>
        <div class="mega" role="menu" aria-label={ui.services}>
          <div class="mega-cols">
            <div class="mega-l2">
              <p class="mega-label">{ui.serviceCategories}</p>
              {services.map((s, i) => (
                <a
                  class:list={['mega-l2-item', { 'is-active': i === 0 }]}
                  href={lp(`services/${s.id}`)}
                  data-panel={s.id}
                >
                  <img src={s.icon} alt="" width="28" height="28" />
                  <span>{serviceTitle(locale, s.id, s.title)}</span>
                </a>
              ))}
            </div>
            <div class="mega-l3">
              <p class="mega-label">{ui.serviceItems}</p>
              {services.map((s, i) => (
                <div class:list={['l3-panel', { show: i === 0 }]} data-l3={s.id}>
                  <a class="l3-title" href={lp(`services/${s.id}`)}>{serviceTitle(locale, s.id, s.title)} · {ui.viewSpecialty}</a>
                  {s.items.length > 0 ? (
                    <ul class="l3-list">
                      {s.items.map((item) => (
                        <li>
                          <span class="l3-static">{item.text}</span>
                        </li>
                      ))}
                    </ul>
                  ) : s.doctorIds.length === 0 ? (
                    <p class="l3-empty">{ui.noItemsWithDoctors}</p>
                  ) : null}
                  {s.doctorIds.length > 0 && (
                    <div class="l3-doctors">
                      <p class="mega-label">{ui.relatedDoctors}</p>
                      <div class="l3-doctor-list">
                        {s.doctorIds.map((id) => {
                          const d = doctors.find((x) => x.id === id);
                          if (!d) return null;
                          return (
                            <a href={`${lp(`doctors/${d.department}`)}#${d.id}`}>
                              <img src={d.image} alt={locale === 'en' ? (d.english || d.name) : d.name} />
                              <span>{locale === 'en' ? (d.english || d.name) : d.name}</span>
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="nav-item has-menu">
        <a class:list={['nav-link', { active: path.includes('/doctors') }]} href={lp("doctors")}>
          {ui.doctors} <span class="caret" aria-hidden="true"></span>
        </a>
        <div class="mega mega-doctors" role="menu" aria-label={ui.doctors}>
          <div class="mega-cols">
            <div class="mega-l2">
              <p class="mega-label">{ui.deptCategories}</p>
              {doctorGroups.map((g, i) => (
                <a
                  class:list={['mega-l2-item', { 'is-active': i === 0 }]}
                  href={lp(`doctors/${g.id}`)}
                  data-panel={g.id}
                >
                  <span>{g.title}</span>
                </a>
              ))}
            </div>
            <div class="mega-l3">
              <p class="mega-label">{ui.deptMembers}</p>
              {doctorGroups.map((g, i) => (
                <div class:list={['l3-panel', { show: i === 0 }]} data-l3={g.id}>
                  <a class="l3-title" href={lp(`doctors/${g.id}`)}>{g.title} · {ui.viewDept}</a>
                  <ul class="l3-list doctors">
                    {g.doctors.map((d) => (
                      <li>
                        <a href={`${lp(`doctors/${g.id}`)}#${d.id}`}>
                          <img src={d.image} alt="" />
                          <span>
                            <strong>{locale === 'en' ? (d.english || d.name) : d.name}</strong>
                            <small>{locale === 'en' ? d.name : d.title}</small>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="nav-item has-menu">
        <a class:list={['nav-link', { active: path.includes('/education') }]} href={lp("education")}>
          {ui.education} <span class="caret" aria-hidden="true"></span>
        </a>
        <div class="mega mega-edu" role="menu" aria-label={ui.education}>
          <div class="mega-cols">
            <div class="mega-l2">
              <p class="mega-label">{ui.eduTopics}</p>
              {eduGroups.map((g, i) => (
                <a
                  class:list={['mega-l2-item', { 'is-active': i === 0 }]}
                  href={lp(`education/${g.id}`)}
                  data-panel={g.id}
                >
                  <span>{g.title}</span>
                </a>
              ))}
            </div>
            <div class="mega-l3">
              <p class="mega-label">{ui.eduArticles}</p>
              {eduGroups.map((g, i) => (
                <div class:list={['l3-panel', { show: i === 0 }]} data-l3={g.id}>
                  <a class="l3-title" href={lp(`education/${g.id}`)}>{g.title} · {ui.viewAll}</a>
                  <ul class="l3-list">
                    {g.articles.slice(0, 8).map((a) => (
                      <li>
                        <a href={lp(`education/${g.id}/${a.slug}`)}>{a.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <a class:list={['nav-link', { active: path.includes('/contact') }]} href={lp("contact")}>{ui.contactNav}</a>
    </nav>

    <div class="actions">
      <a class="search-btn" href={lp("search")} aria-label={ui.search}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="search-text">{ui.search}</span>
      </a>
      <div class="lang-desk">
        <a class="lang-trigger" href={otherHref}>{ui.langLabel}<span class="lang-swap"> · {ui.langOther}</span></a>
      </div>
      <a class="wa-btn header-wa" href={site.whatsapp} target="_blank" rel="noreferrer">
        <img src="/assets/whatsapp.svg" alt="" />
        <span class="wa-text">{ui.bookWhatsapp}</span>
      </a>
      <button class="mobile-toggle" type="button" data-mobile-open aria-label={ui.openMenu} aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!--
  抽屉与遮罩必须放在 <header> 外面：header 上有 backdrop-filter，
  会成为其内部 position:fixed 子元素的定位参照，放在里面会被压成顶栏那么高的一条。
-->
<div class="mobile-backdrop" data-mobile-backdrop hidden></div>
<aside class="mobile-panel" data-mobile-drawer hidden>
    <div class="mobile-panel-top">
      <a class="logo" href={lp()} aria-label={ui.home}>
        <img src="/assets/logo.png" alt={locale === 'en' ? site.nameEn : site.name} />
      </a>
      <button type="button" class="mobile-close" data-mobile-close aria-label={ui.closeMenu}>✕</button>
    </div>

    <nav class="mobile-nav" aria-label={locale === 'en' ? 'Mobile' : '手機選單'}>
      <details class="m-acc">
        <summary class:list={[{ active: isHome || path.includes('/about') }]}>{ui.home}</summary>
        <div class="m-sub">
          <a href={lp()}>{ui.home}</a>
          <a href={`${lp('about')}#about`}>{ui.about}</a>
          <a href={`${lp('about')}#environment`}>{ui.clinicEnv}</a>
        </div>
      </details>

      <details class="m-acc">
        <summary class:list={[{ active: path.includes('/services') }]}>{ui.services}</summary>
        <div class="m-sub">
          <a href={lp("services")}>{ui.services}</a>
          {services.map((s) => (
            <a href={lp(`services/${s.id}`)}>{serviceTitle(locale, s.id, s.title)}</a>
          ))}
        </div>
      </details>

      <details class="m-acc">
        <summary class:list={[{ active: path.includes('/doctors') }]}>{ui.doctors}</summary>
        <div class="m-sub">
          <a href={lp("doctors")}>{ui.doctors}</a>
          {doctorGroups.map((g) => (
            <a href={lp(`doctors/${g.id}`)}>{g.title}</a>
          ))}
        </div>
      </details>

      <details class="m-acc">
        <summary class:list={[{ active: path.includes('/education') }]}>{ui.education}</summary>
        <div class="m-sub">
          <a href={lp("education")}>{ui.education}</a>
          {eduGroups.map((g) => (
            <a href={lp(`education/${g.id}`)}>{g.title}</a>
          ))}
        </div>
      </details>

      <a class:list={['m-link', { active: path.includes('/search') }]} href={lp("search")}>{ui.search}</a>
      <a class:list={['m-link', { active: path.includes('/contact') }]} href={lp("contact")}>{ui.contactNav}</a>
    </nav>

    <div class="mobile-lang">
      <p>{ui.langSwitch}</p>
      <div class="lang-row">
        <a class:list={['lang-chip', { active: locale === 'zh' }]} href={switchLocalePath(path, 'zh')}>繁體中文</a>
        <a class:list={['lang-chip', { active: locale === 'en' }]} href={switchLocalePath(path, 'en')}>English</a>
      </div>
    </div>

    <a class="wa-btn mobile-wa" href={site.whatsapp} target="_blank" rel="noreferrer">
      <img src="/assets/whatsapp.svg" alt="" />
      {ui.bookWhatsapp}
    </a>
</aside>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(217, 232, 236, 0.8);
  }
  .header-inner {
    position: relative;
    width: min(1360px, calc(100% - 40px));
    padding-left: 30px;
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: nowrap;
  }
  .logo { flex: 0 1 auto; min-width: 0; }
  .logo img { height: clamp(40px, 4.2vw, 60px); width: auto; max-width: min(280px, 48vw, 100%); object-fit: contain; }
  .nav {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    flex-shrink: 0;
    gap: 0;
    margin-left: auto;
    margin-right: 8px;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 10px clamp(5px, calc(1.1vw - 3.5px), 11px);
    color: #444;
    font-size: clamp(13px, calc(0.6vw + 7px), 15px);
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color .15s ease;
  }
  .nav-link:hover { color: var(--cyan); }
  .nav-link.active { color: var(--cyan); font-weight: 600; }
  .nav-link.active::after {
    content: "";
    position: absolute;
    left: clamp(5px, calc(1.1vw - 3.5px), 11px);
    right: clamp(5px, calc(1.1vw - 3.5px), 11px);
    bottom: 2px;
    height: 3px;
    border-radius: 999px;
    background: var(--cyan);
  }
  .caret {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
    opacity: .65;
  }
  /* 大菜单宽 860px，挂在单个菜单项上时窄屏笔记本会被裁掉，改挂在 .header-inner 上。
     首页那个小菜单只有 240px，仍然挂在自己的菜单项上（.nav 的第一项）。 */
  .nav-item { position: static; flex-shrink: 0; }
  .nav-item:first-child { position: relative; }
  .mega {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    left: auto;
    width: min(860px, 100%);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 18px 50px rgba(0, 40, 50, 0.12);
    padding: 18px;
  }
  .mega::before {
    content: "";
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  .nav-item:hover .mega,
  .nav-item:focus-within .mega { display: block; }
  .mega-cols { display: grid; grid-template-columns: 280px 1fr; gap: 14px; min-height: 340px; }
  .mega-label {
    margin: 0 0 10px;
    font-size: 12px;
    color: #8a9aa0;
    letter-spacing: .04em;
    font-weight: 600;
  }
  .mega-l2 {
    border-right: 1px solid var(--line);
    padding-right: 14px;
    max-height: 440px;
    overflow: auto;
  }
  .mega-l2-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 14px;
    color: #333;
  }
  .mega-l2-item img { width: 28px; height: 28px; object-fit: contain; }
  .mega-l2-item:hover,
  .mega-l2-item.is-active { background: var(--cyan-soft); color: var(--cyan-hover); }
  .l3-panel { display: none; }
  .l3-panel.show { display: block; }
  .l3-title {
    display: inline-block;
    margin-bottom: 10px;
    color: var(--cyan);
    font-weight: 700;
    font-size: 14px;
  }
  .l3-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; max-height: 280px; overflow: auto; }
  .l3-list a {
    display: block;
    padding: 8px 10px;
    border-radius: 10px;
    font-size: 14px;
    color: #333;
  }
  .l3-list a:hover { background: var(--cyan-soft); color: var(--cyan-hover); }
  .l3-static {
    display: block;
    padding: 7px 10px;
    font-size: 13.5px;
    color: #8a9aa0;
    font-weight: 400;
    cursor: default;
    user-select: text;
  }
  .mega-simple {
    width: min(240px, calc(100vw - 32px));
    right: auto;
    left: 0;
    padding: 10px;
    display: none;
    grid-template-columns: 1fr;
    min-height: 0;
  }
  .nav-item:hover .mega-simple,
  .nav-item:focus-within .mega-simple { display: grid; }
  .mega-simple a {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 14px;
    color: #333;
    font-weight: 600;
  }
  .mega-simple a:hover { background: var(--cyan-soft); color: var(--cyan-hover); }
  .l3-list.doctors a {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .l3-list.doctors img {
    width: 36px; height: 36px; border-radius: 50%; object-fit: cover;
  }
  .l3-list.doctors small { display: block; color: var(--muted); font-size: 12px; }
  .l3-empty { color: var(--muted); font-size: 13px; margin: 0; }
  .l3-doctors { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); }
  .l3-doctor-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .l3-doctor-list a {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 10px 6px 6px; border-radius: 999px; background: #f4fafb; font-size: 13px;
  }
  .l3-doctor-list img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
  .actions { display: flex; align-items: center; gap: clamp(6px, 0.8vw, 10px); flex: 0 0 auto; }
  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #f7fafb;
    color: #333;
    font-size: 13px;
    font-weight: 600;
  }
  .search-btn:hover { border-color: var(--cyan); color: var(--cyan-hover); }
  .lang-trigger {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 4px clamp(8px, 1vw, 14px);
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #f7fafb;
    font-size: 13px;
    font-weight: 600;
    color: #333;
  }
  .lang-trigger:hover { border-color: var(--cyan); color: var(--cyan-hover); }
  .lang-swap { color: var(--muted); font-weight: 500; }
  .header-wa { min-height: 48px; padding-inline: clamp(12px, 2vw, 28px); }
  .mobile-toggle {
    display: none;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 12px;
    width: 42px; height: 42px;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .mobile-toggle span {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: #333;
  }
  .mobile-backdrop {
    position: fixed; inset: 0; z-index: 55;
    background: rgba(0,0,0,.28);
  }
  .mobile-backdrop[hidden],
  .mobile-panel[hidden] { display: none !important; }

  .mobile-panel {
    position: fixed;
    inset: 12px;
    z-index: 60;
    background: #fff;
    border-radius: 22px;
    padding: 18px 18px 24px;
    overflow: auto;
    box-shadow: 0 20px 60px rgba(0,30,40,.18);
    display: flex;
    flex-direction: column;
  }
  .mobile-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .mobile-panel-top .logo img { height: 40px; }
  .mobile-close {
    width: 40px; height: 40px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--cyan);
    font-size: 26px;
    line-height: 1;
  }
  .mobile-nav { display: grid; align-content: start; gap: 6px; flex: 1 1 auto; }
  .m-link, .m-acc > summary {
    display: block;
    padding: 14px 16px;
    border-radius: 14px;
    font-size: 18px;
    font-weight: 600;
    color: #222;
  }
  .m-link.active,
  .m-acc > summary.active {
    background: #dff7f9;
    color: #0f8a98;
  }
  .m-acc > summary {
    list-style: none;
    cursor: pointer;
  }
  .m-acc > summary::-webkit-details-marker { display: none; }
  .m-acc > summary::after {
    content: "▾";
    float: right;
    color: #99b4b8;
    font-size: 14px;
  }
  .m-acc[open] > summary::after { content: "▴"; }
  .m-sub {
    display: grid;
    gap: 2px;
    padding: 4px 8px 10px 12px;
  }
  .m-sub a {
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 15px;
    color: #445;
  }
  .m-sub a:hover { background: #f4fafb; color: var(--cyan); }
  .mobile-lang {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid #e8eef0;
  }
  .mobile-lang p {
    margin: 0 0 10px;
    font-size: 13px;
    color: #8a9aa0;
  }
  .lang-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .lang-chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 12px;
    background: #f1f5f6;
    color: #667;
    font-size: 13px;
    font-weight: 600;
  }
  .lang-chip.active {
    background: #dff7f9;
    color: #0f8a98;
  }
  .mobile-wa {
    margin-top: 20px;
    width: 100%;
    flex: 0 0 auto;
  }

  /* 窄屏笔记本（含 1366 屏开 125% 缩放）先收紧桌面顶栏，而不是直接切手机菜单。
     字号与内距用 clamp() 平滑收缩，这里只放不能平滑处理的开关。 */
  @media (max-width: 1280px) {
    .header-inner { padding-left: 12px; }
    .lang-swap { display: none; }
  }
  @media (max-width: 1180px) {
    .search-text { display: none; }
    .search-btn { width: 36px; height: 36px; min-height: 36px; padding: 0; justify-content: center; border-radius: 12px; }
  }

  /* 英文菜单文字比中文长得多，1140px 以下就换手机抽屉；中文能撑到 1000px。 */
  @media (max-width: 1140px) {
    .header.locale-en .header-inner { width: min(1180px, calc(100% - 40px)); min-height: var(--header-h); padding-left: 0; }
    .header.locale-en .nav,
    .header.locale-en .lang-desk { display: none; }
    .header.locale-en .mobile-toggle { display: inline-flex; }
    .header.locale-en .logo img { height: 36px; }
    .header.locale-en .header-wa { min-width: 0; padding: 0 12px; }
  }

  @media (max-width: 1000px) {
    .header-inner { width: min(1180px, calc(100% - 40px)); min-height: var(--header-h); padding-left: 0; }
    .nav { display: none; }
    .lang-desk { display: none; }
    .search-text { display: none; }
    .search-btn { width: 40px; height: 40px; min-height: 40px; padding: 0; justify-content: center; border-radius: 12px; }
    .mobile-toggle { display: inline-flex; }
    .logo img { height: 36px; }
    .header-wa { min-width: 0; padding: 0 12px; }
  }
  @media (max-width: 420px) {
    .header-inner { width: calc(100% - 28px); }
    .header-wa .wa-text { display: none; }
    .header-wa { width: 40px; height: 40px; min-height: 40px; padding: 0; border-radius: 12px; }
  }
</style>

<script>
  const openBtn = document.querySelector('[data-mobile-open]');
  const closeBtn = document.querySelector('[data-mobile-close]');
  const drawer = document.querySelector('[data-mobile-drawer]');
  const backdrop = document.querySelector('[data-mobile-backdrop]');

  const openDrawer = () => {
    drawer?.removeAttribute('hidden');
    backdrop?.removeAttribute('hidden');
    document.body.classList.add('drawer-open');
    openBtn?.setAttribute('aria-expanded', 'true');
  };
  const closeDrawer = () => {
    drawer?.setAttribute('hidden', '');
    backdrop?.setAttribute('hidden', '');
    document.body.classList.remove('drawer-open');
    openBtn?.setAttribute('aria-expanded', 'false');
  };

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));

  document.querySelectorAll('.mega').forEach((mega) => {
    const items = mega.querySelectorAll('.mega-l2-item');
    const panels = mega.querySelectorAll('.l3-panel');
    items.forEach((item) => {
      const activate = () => {
        const id = item.getAttribute('data-panel');
        items.forEach((x) => x.classList.toggle('is-active', x === item));
        panels.forEach((p) => p.classList.toggle('show', p.getAttribute('data-l3') === id));
      };
      item.addEventListener('mouseenter', activate);
      item.addEventListener('focus', activate);
    });
  });
</script>
