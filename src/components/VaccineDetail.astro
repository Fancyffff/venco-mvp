---
/**
 * 兒童疫苗接種頁的專屬內容。只有 services/[slug] 的 vaccine 這一頁會用到。
 * 所有文字逐字來自診所《強健寶寶 防疫注射》單張，存在 src/data/vaccine.json，
 * 改內容請改 json，不要在這裡寫死。
 */
import data from '../data/vaccine.json';

interface Props {
  /** 'b' = 把 logo 的顏色柔化後揉進頁面，每個板塊認領一個顏色。'a' 是原來的全青色。 */
  variant?: 'a' | 'b';
}
const { variant = 'a' } = Astro.props;

const kindLabel = { check: '健康檢查', shot: '注射疫苗', oral: '口服疫苗' };

// 家長是按「這針防什麼病」在找資料，所以按疫苗分組；
// 白喉／破傷風／百日咳本來就是同一針，分開列反而難懂。順序照單張。
const byVaccine = [];
for (const row of data.diseases.rows) {
  const hit = byVaccine.find((g) => g.vaccine === row.vaccine);
  if (hit) hit.diseases.push(row);
  else byVaccine.push({ vaccine: row.vaccine, diseases: [row] });
}
---
<div class:list={['vx-root', variant === 'b' && 'theme-b']}>
<section class="v-intro">
  <div class="intro-copy">
    <span class="intro-eyebrow">給寶寶安心、完整的疫苗保護</span>
    <p>{data.intro}</p>
  </div>
  <img
    class="intro-art"
    src="/assets/img/venco_vaccine_character_legacy.png"
    alt="口罩與疫苗針筒的兒童插畫"
  />
</section>

<nav class="jump" aria-label="本頁內容">
  <a href="#plans"><span aria-hidden="true">✓</span>疫苗計劃</a>
  <a href="#diseases"><span aria-hidden="true">✦</span>可預防的傳染病</a>
  <a href="#aftercare"><span aria-hidden="true">♡</span>注射後護理</a>
  <a href="#schedule"><span aria-hidden="true">▦</span>接種時間表</a>
</nav>

<section class="v-block" id="plans">
  <div class="section-heading">
    <span class="section-icon" aria-hidden="true">✓</span>
    <div>
      <h2>{data.plans.title}</h2>
      <p class="lead">{data.plans.lead}</p>
    </div>
  </div>

  <div class="plan-tabs" data-plan-tabs>
    <div class="tab-row" role="tablist" aria-label={data.plans.title}>
      {data.plans.list.map((p, i) => (
        <button
          type="button"
          role="tab"
          class:list={['tab', { on: i === 0 }]}
          data-tab={p.id}
          id={`tab-${p.id}`}
          aria-controls={`panel-${p.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
        >{p.name}</button>
      ))}
    </div>

    {data.plans.list.map((p, i) => (
      <div
        class:list={['tab-panel', { on: i === 0 }]}
        data-plan-panel={p.id}
        id={`panel-${p.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${p.id}`}
        hidden={i !== 0}
      >
        <div class="t-scroll">
          <table class="plan">
            <caption class="sr-only">{p.name}</caption>
            <thead>
              <tr>
                <th scope="col">年齡</th>
                {p.ages.map((a) => <th scope="col">{a}</th>)}
              </tr>
            </thead>
            <tbody>
              {p.rows.map((r) => (
                <tr>
                  <th scope="row">{r.item}</th>
                  {r.cells.map((c, ci) => (
                    <td class:list={[c && `is-${c}`]}>
                      {c ? <span class="dot" title={`${p.ages[ci]}：${kindLabel[c]}`}>
                        <span class="sr-only">{`${p.ages[ci]}　${kindLabel[c]}`}</span>
                      </span> : <span class="sr-only">—</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* 手機上表格會被切掉，改成按月齡拆開的卡片，一眼看得全，不用左右滑 */}
        <div class="plan-cards">
          {p.ages.map((age, ci) => {
            const hits = p.rows.filter((r) => r.cells[ci]);
            return (
              <div class="pc">
                <p class="pc-age">{age}</p>
                {hits.length > 0 ? (
                  <ul>
                    {hits.map((r) => (
                      <li>
                        <span class:list={['dot', `is-${r.cells[ci]}`]} aria-hidden="true"></span>
                        <span>{r.item}</span>
                        <em>{kindLabel[r.cells[ci]]}</em>
                      </li>
                    ))}
                  </ul>
                ) : <p class="pc-none">此階段沒有安排</p>}
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <ul class="legend">
    {data.plans.legend.map((l) => (
      <li><span class:list={['dot', `is-${l.kind}`]}></span>{l.label}</li>
    ))}
  </ul>
  <ul class="notes">
    {data.plans.footnotes.map((f) => <li>{f}</li>)}
  </ul>
</section>

<section class="v-block" id="diseases">
  <div class="section-heading">
    <span class="section-icon" aria-hidden="true">✦</span>
    <div>
      <h2>{data.diseases.title}</h2>
      <p class="lead">{data.diseases.lead}</p>
    </div>
  </div>
  <div class="acc">
    {byVaccine.map((g) => (
      <details>
        <summary>
          <span class="vx-name">{g.vaccine}</span>
          <span class="vx-tags">{g.diseases.map((d) => <em>{d.disease}</em>)}</span>
        </summary>
        <div class="acc-body">
          <ul class="dz">
            {g.diseases.map((d) => (
              <li>
                <strong>{d.disease}</strong>
                <span>{d.effect}</span>
              </li>
            ))}
          </ul>
        </div>
      </details>
    ))}
  </div>
</section>

<section class="v-block" id="aftercare">
  <div class="aftercare-heading">
    <div class="section-heading">
      <span class="section-icon" aria-hidden="true">♡</span>
      <div>
        <h2>{data.aftercare.title}</h2>
        <p class="lead">{data.aftercare.lead}</p>
      </div>
    </div>
    <img src="/assets/img/venco_vaccine_aftercare_legacy.png" alt="疫苗注射後護理插畫" />
  </div>
  <details class="fold">
    <summary>{`查看 ${data.aftercare.groups.length} 類疫苗的注射後反應及護理`}</summary>
    <div class="acc inner">
    {data.aftercare.groups.map((g) => (
      <details>
        <summary>{g.name}</summary>
        <div class="acc-body">
          <p>{g.intro}</p>
          <ol>{g.points.map((pt) => <li>{pt}</li>)}</ol>
        </div>
      </details>
    ))}
    </div>
  </details>
</section>

<section class="v-block" id="schedule">
  <div class="section-heading">
    <span class="section-icon" aria-hidden="true">▦</span>
    <div>
      <h2>{data.schedule.title}</h2>
      <p class="lead">{data.schedule.lead}</p>
    </div>
  </div>

  <details class="fold">
    <summary>{data.schedule.gov.title}</summary>
    <div class="t-scroll">
    <table class="sched">
      <thead><tr><th scope="col">年齡</th><th scope="col">接種疫苗</th></tr></thead>
      <tbody>
        {data.schedule.gov.rows.map((r) => (
          <tr><th scope="row">{r.age}</th><td>{r.text ? r.text.split('\n').map((l, i) => <span class="ln">{l}</span>) : <span class="none">—</span>}</td></tr>
        ))}
      </tbody>
    </table>
    </div>
  </details>

  <details class="fold">
    <summary>{data.schedule.private.title}</summary>
    <div class="t-scroll">
    <table class="sched">
      <thead>
        <tr>
          <th scope="col">年齡</th>
          {data.schedule.private.columns.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {data.schedule.private.rows.map((r) => (
          <>
            {r.flexible || r.simple ? (
              <tr>
                <th scope="row" rowspan={r.both ? 2 : 1}>{r.age}</th>
                <td>{(r.flexible || '').split('\n').map((l) => <span class="ln">{l}</span>)}</td>
                <td>{(r.simple || '').split('\n').map((l) => <span class="ln">{l}</span>)}</td>
              </tr>
            ) : null}
            {r.both ? (
              <tr>
                {!(r.flexible || r.simple) && <th scope="row">{r.age}</th>}
                <td colspan="2" class="span">{r.both.split('\n').map((l) => <span class="ln">{l}</span>)}</td>
              </tr>
            ) : null}
          </>
        ))}
      </tbody>
    </table>
    </div>
  </details>

  <p class="disclaimer">{data.disclaimer}</p>
</section>
</div>

<style>
  /* ── A 版：全部沿用品牌青色。每個板塊都讀 --accent，B 版只換這幾個變數。 ── */
  .vx-root {
    --accent: var(--cyan);
    --accent-deep: var(--cyan-hover);
    --accent-soft: var(--cyan-soft);
    --accent-line: var(--line);
    --oral: #e0559a;
    --shot: #35b37e;
  }

  /*
   * ── B 版：logo 的六個顏色調淡後揉進頁面 ──
   * 取自 public/assets/logo.png 實際取樣：
   *   青 #00a8c0　淡藍 #a8d8f0　黃 #f0c03c　綠 #008460　橙 #f08418　紅 #e45448
   * 每個板塊認領一個顏色，底色一律壓到 8-14% 透明度當淺底，深色只用在標題與圓點。
   * 紅色刻意不用——醫療頁面上紅色會被讀成「警告」。
   */
  /*
   * ══ B 版調色盤 ══
   * 客戶的 logo 刻意做成五彩，所以這裡讓幾個顏色平起平坐，不是只拿青色當主色。
   * 顏色值取樣自 public/assets/logo.png，用 R,G,B 三個數字寫（要配 rgba() 調透明度）。
   *
   * 想換某一塊的顏色：把下面「板塊認領」裡那一行的 --l-xxx 換成別的就行，
   * 深色文字 --accent-deep 記得跟著換（要夠深才看得清）。
   */
  .theme-b {
    --l-cyan: 0, 168, 192;
    --l-blue: 168, 216, 240;
    --l-yellow: 240, 192, 60;
    --l-green: 0, 132, 96;
    --l-orange: 240, 132, 24;
  }
  /* ── 板塊認領：一塊一個顏色 ── */
  .theme-b #plans {
    --accent: rgb(var(--l-cyan));
    --accent-deep: #00707f;
    --accent-soft: rgba(var(--l-cyan), .10);
    --accent-wash: rgba(var(--l-cyan), .16);
    --accent-line: rgba(var(--l-cyan), .34);
  }
  .theme-b #diseases {
    --accent: rgb(var(--l-green));
    --accent-deep: #005c43;
    --accent-soft: rgba(var(--l-green), .09);
    --accent-wash: rgba(var(--l-green), .14);
    --accent-line: rgba(var(--l-green), .30);
  }
  .theme-b #aftercare {
    --accent: rgb(var(--l-orange));
    --accent-deep: #a85606;
    --accent-soft: rgba(var(--l-orange), .11);
    --accent-wash: rgba(var(--l-orange), .18);
    --accent-line: rgba(var(--l-orange), .34);
  }
  .theme-b #schedule {
    --accent: #3d9ad4;
    --accent-deep: #26688f;
    --accent-soft: rgba(var(--l-blue), .30);
    --accent-wash: rgba(var(--l-blue), .45);
    --accent-line: rgba(61, 154, 212, .36);
  }
  .theme-b { --oral: rgb(var(--l-yellow)); --shot: rgb(var(--l-green)); }

  /* 每個板塊整塊上色，顏色成片出現，而不是只描邊 */
  .theme-b .v-block {
    padding: 24px 22px 26px;
    border-radius: 24px;
    background: linear-gradient(170deg, var(--accent-wash) 0%, var(--accent-soft) 42%, #fff 100%);
    border: 1px solid var(--accent-line);
  }
  .theme-b .v-block > h2 {
    display: flex; align-items: center; gap: 10px;
    color: var(--accent-deep);
  }
  .theme-b .v-block > h2::before {
    content: ""; flex: 0 0 auto;
    width: 10px; height: 26px; border-radius: 4px;
    background: var(--accent);
  }
  .theme-b .lead { color: #4a5a5e; }

  /* 開場白這塊單獨一個顏色，換 --intro-rgb 就整塊變色 */
  .theme-b .v-intro {
    /* 想換開場白的顏色，只改這兩行：
       可選 --l-cyan / --l-blue / --l-yellow / --l-green / --l-orange，
       strength 是濃度，淡色（blue/yellow）可以到 .55，深色（green/cyan）建議 .16 以內 */
    --intro-rgb: var(--l-yellow);
    --intro-strength: .30;
    background: linear-gradient(135deg,
      rgba(var(--intro-rgb), calc(var(--intro-strength) * .45)),
      rgba(var(--intro-rgb), var(--intro-strength)));
    border: 1px solid rgba(var(--intro-rgb), calc(var(--intro-strength) * .55));
  }

  /* 跳轉按鈕直接染成各自板塊的顏色，不用等滑鼠移上去 */
  .theme-b .jump { border-bottom-color: rgba(var(--l-cyan), .22); }
  .theme-b .jump a { border-width: 1.5px; font-weight: 700; }
  .theme-b .jump a:nth-child(1) { border-color: rgba(var(--l-cyan), .45); color: #00707f; background: rgba(var(--l-cyan), .12); }
  .theme-b .jump a:nth-child(2) { border-color: rgba(var(--l-green), .40); color: #005c43; background: rgba(var(--l-green), .10); }
  .theme-b .jump a:nth-child(3) { border-color: rgba(var(--l-orange), .45); color: #a85606; background: rgba(var(--l-orange), .13); }
  .theme-b .jump a:nth-child(4) { border-color: rgba(61, 154, 212, .45); color: #26688f; background: rgba(var(--l-blue), .40); }
  .theme-b .jump a:nth-child(1):hover { background: rgba(var(--l-cyan), .24); }
  .theme-b .jump a:nth-child(2):hover { background: rgba(var(--l-green), .20); }
  .theme-b .jump a:nth-child(3):hover { background: rgba(var(--l-orange), .26); }
  .theme-b .jump a:nth-child(4):hover { background: rgba(var(--l-blue), .70); }

  /* 沒選中的分頁也帶淺色，選中的填滿 */
  .theme-b .tab { background: rgba(255,255,255,.75); border-color: var(--accent-line); color: var(--accent-deep); }
  .theme-b .tab.on { background: var(--accent); border-color: var(--accent); color: #fff; box-shadow: 0 4px 14px var(--accent-soft); }

  /* 折疊條收起時就有底色，不再是一排白盒子 */
  .theme-b .acc details,
  .theme-b details.fold {
    background: rgba(255,255,255,.72);
    border-color: var(--accent-line);
  }
  .theme-b .acc summary,
  .theme-b details.fold > summary { color: var(--accent-deep); }
  .theme-b .acc details[open],
  .theme-b details.fold[open] { border-color: var(--accent); }
  .theme-b .acc.inner { background: var(--accent-soft); }
  .theme-b .vx-tags em { background: var(--accent-wash); color: var(--accent-deep); font-weight: 600; }
  .theme-b .acc details[open] .vx-tags em { background: #fff; }

  /* 月齡卡：標題掛一條色塊，一眼分得出段落 */
  .theme-b .pc {
    background: rgba(255,255,255,.86);
    border-color: var(--accent-line);
  }
  .theme-b .pc-age {
    display: inline-block;
    padding: 4px 12px; margin-bottom: 10px;
    border-radius: 999px;
    background: var(--accent); color: #fff; font-size: 13px;
  }
  .theme-b thead th { background: var(--accent-wash); color: var(--accent-deep); }
  .theme-b tbody th { color: #223; }
  .theme-b .t-scroll { border-color: var(--accent-line); }
  .theme-b .disclaimer {
    background: rgba(var(--l-yellow), .20);
    border-left-color: rgb(var(--l-yellow));
    color: #6b5a2a;
  }

  @media (max-width: 700px) {
    .theme-b .v-block { padding: 18px 14px 20px; border-radius: 20px; }
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .jump {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin: 0 0 28px; padding-bottom: 20px; border-bottom: 1px solid var(--line);
  }
  .jump a {
    display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 0 15px;
    border: 1px solid var(--line); border-radius: 999px;
    background: #fff; color: #334; font-size: 14px; font-weight: 600;
  }
  .jump a span {
    display: grid; place-items: center; width: 22px; height: 22px;
    border-radius: 50%; background: var(--accent-soft); color: var(--accent-deep);
    font-size: 13px; font-weight: 800;
  }
  .jump a:hover { border-color: var(--accent); color: var(--accent-deep); background: var(--accent-soft); }

  .v-intro {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 36%);
    align-items: center; gap: 28px;
    margin: 0 0 22px; padding: 28px 34px;
    min-height: 250px; overflow: hidden;
    background:
      radial-gradient(circle at 88% 18%, rgba(255,255,255,.92), transparent 35%),
      linear-gradient(135deg, #e9f9fb 0%, #f4fbfc 56%, #eef0ff 100%);
    border: 1px solid #d7edf1; border-radius: 28px;
  }
  .intro-copy { position: relative; z-index: 1; }
  .intro-eyebrow {
    display: inline-block; margin-bottom: 13px; padding: 7px 12px;
    border-radius: 999px; background: rgba(0,168,192,.12); color: var(--cyan-hover);
    font-size: 13px; line-height: 1; font-weight: 700; letter-spacing: .02em;
  }
  .v-intro p { margin: 0; max-width: 650px; color: #33474b; line-height: 1.95; font-size: 16px; }
  .intro-art {
    display: block; width: min(100%, 340px); height: auto; justify-self: end;
    filter: drop-shadow(0 14px 20px rgba(42,124,139,.08));
  }

  .v-block { margin: 0 0 48px; scroll-margin-top: 96px; }
  .section-heading { display: flex; align-items: flex-start; gap: 13px; margin: 0 0 18px; }
  .section-icon {
    display: grid; place-items: center; flex: 0 0 auto;
    width: 42px; height: 42px; border-radius: 14px;
    background: var(--accent-soft); border: 1px solid var(--accent-line);
    color: var(--accent-deep); font-size: 20px; font-weight: 800;
  }
  .v-block h2 { margin: 0 0 6px; font-size: clamp(1.3rem, 2.6vw, 1.6rem); }
  .lead { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.7; }
  .sub { margin: 28px 0 10px; font-size: 15px; color: var(--accent-deep); }

  .aftercare-heading {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, 42%);
    align-items: center; gap: 18px; margin-bottom: 14px;
    padding: 18px 22px 0; overflow: hidden;
    border: 1px solid #d9eeee; border-radius: 22px;
    background: linear-gradient(110deg, #f7ffff 0%, #effafa 58%, #fbfde9 100%);
  }
  .aftercare-heading .section-heading { margin-bottom: 18px; }
  .aftercare-heading img { display: block; width: 100%; height: auto; align-self: end; }

  .tab-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .tab {
    min-height: 42px; padding: 0 20px; border-radius: 999px;
    border: 1px solid var(--line); background: #fff;
    font-size: 14.5px; font-weight: 600; color: #334;
  }
  .tab:hover { border-color: var(--accent); color: var(--accent-deep); }
  .tab.on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .tab-panel[hidden] { display: none; }

  /* 表格較寬，讓它自己橫向捲動，不要撐破頁面 */
  .t-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 16px; border: 1px solid var(--line); }
  table { width: 100%; border-collapse: collapse; background: #fff; font-size: 14px; }
  caption { text-align: left; }
  th, td { padding: 10px 12px; border-bottom: 1px solid #eef3f5; text-align: left; vertical-align: top; }
  thead th { background: var(--soft); font-size: 13px; color: #445; white-space: nowrap; position: sticky; top: 0; }
  tbody th { font-weight: 600; color: #223; white-space: nowrap; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }

  .plan td { text-align: center; }
  .plan thead th:not(:first-child) { text-align: center; }
  .dot {
    display: inline-block; width: 15px; height: 15px; border-radius: 50%;
    background: #dfe8ea;
  }
  .is-check .dot, .dot.is-check { background: var(--accent); }
  .is-shot .dot, .dot.is-shot { background: var(--shot); }
  .is-oral .dot, .dot.is-oral { background: var(--oral); }

  .plan-cards { display: none; }
  .pc {
    border: 1px solid var(--line); border-radius: 14px;
    background: #fff; padding: 12px 14px;
  }
  .pc-age {
    margin: 0 0 8px; font-size: 14px; font-weight: 700; color: var(--accent-deep);
  }
  .pc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
