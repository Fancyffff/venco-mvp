---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocale, switchLocalePath, t } from '../lib/i18n';
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Error pages: keep them out of search results and give them no canonical. */
  noindex?: boolean;
}
const locale = getLocale(Astro.url.pathname);
const ui = t(locale);
const { title, description = ui.siteDesc, noindex = false } = Astro.props;

// Astro.site is unset only if someone drops `site` from astro.config; fall back
// so the build can't silently emit half-formed canonical URLs.
const origin = Astro.site ?? new URL('https://vencokids.com');
const abs = (p: string) => new URL(p, origin).href;
const path = Astro.url.pathname;
const canonical = abs(path);
// The 404 page lives outside /zh and /en, so it has no language counterpart.
const hasLocalePair =
  !noindex &&
  (path === '/zh' || path === '/en' || path.startsWith('/zh/') || path.startsWith('/en/'));
const ogImage = abs(site.homeHero);
---
<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-Hant'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {hasLocalePair && (
      <>
        <link rel="alternate" hreflang="zh-Hant" href={abs(switchLocalePath(path, 'zh'))} />
        <link rel="alternate" hreflang="en" href={abs(switchLocalePath(path, 'en'))} />
        <link rel="alternate" hreflang="x-default" href={abs(switchLocalePath(path, 'zh'))} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={locale === 'en' ? site.nameEn : site.name} />
    <meta property="og:locale" content={locale === 'en' ? 'en' : 'zh_HK'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
