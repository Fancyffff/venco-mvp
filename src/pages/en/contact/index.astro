---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import site from '../../../data/site.json';
import doctors from '../../../data/doctors.json';
import { t } from '../../../lib/i18n';

const ui = t('en');
const locations = site.locations.map((loc, i) => ({
  ...loc,
  ...(site.locationsEn?.[i] || {}),
  hoursRows: loc.hoursRowsEn || loc.hoursRows,
}));
---
<BaseLayout title={`${ui.contactNav} | ${site.nameEn}`} description="Contact Venco Medical Centre for appointments and clinic hours.">
  <section class="hero" style={site.contactHero ? `--hero:url(${site.contactHero})` : undefined}>
    <div class="container">
      <h1>{ui.contactNav}</h1>
      <p class="lead">We welcome your enquiry and booking</p>
    </div>
  </section>

  <section class="page">
    <div class="container">
      <h2 class="sec-title">{ui.hours}</h2>
      <div class="hours-grid">
        {locations.map((loc) => (
          <div class="hours-box">
            <h3>{loc.name}</h3>
            <ul>
              {(loc.hoursRows || []).map((row) => (
                <li><span>{row.days}</span><strong>{row.time}</strong></li>
              ))}
            </ul>
            <p class="phone">{loc.phone}</p>
          </div>
        ))}
      </div>

      <h2 class="sec-title">Book a doctor on WhatsApp</h2>
      <div class="doc-grid">
        {doctors.map((d) => (
          <a class="doc" href={d.whatsapp} target="_blank" rel="noreferrer">
            <img src={d.image} alt={d.english || d.name} />
            <div>
              <strong>{d.english || d.name}</strong>
              <small>{d.name}</small>
            </div>
          </a>
        ))}
      </div>

      <h2 class="sec-title loc-title">Clinic locations</h2>
      <div class="grid">
        {locations.map((loc) => (
          <article class="card">
            <img src={loc.mapImage} alt={`${loc.name} map`} />
            <div>
              <h3>{loc.name}</h3>
              <p>Address: {loc.address}</p>
              <p class="phone">Tel: {loc.phone}</p>
              {loc.fax && <p>Fax: {loc.fax}</p>}
            </div>
          </article>
        ))}
      </div>

      <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
        <img src="/assets/whatsapp.svg" alt="" /> {ui.bookWhatsapp}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 72px 0 56px;
    background:
      linear-gradient(90deg, rgba(255,255,255,.94), rgba(255,255,255,.45)),
      var(--hero, none) center right / cover no-repeat;
    background-color: #e8f7f9;
  }
  .hero h1 { margin: 0; font-size: clamp(2rem, 4vw, 2.8rem); }
  .lead { margin: 12px 0 0; color: #444; font-size: 16px; }
  .page { padding: 40px 0 80px; }
  .sec-title { margin: 0 0 14px; font-size: 20px; }
  .loc-title { margin-top: 36px; }
  .hours-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 36px;
  }
  .hours-box {
    padding: 20px 22px;
    border-radius: 16px;
    background: var(--soft);
    border: 1px solid var(--line);
  }
  .hours-box h3 { margin: 0 0 12px; font-size: 18px; }
  .hours-box ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .hours-box li { display: flex; justify-content: space-between; gap: 16px; font-size: 14px; color: #444; }
  .hours-box .phone { margin: 14px 0 0; color: var(--cyan-hover); font-weight: 600; }
  .doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
    margin-bottom: 8px;
  }
  .doc {
    display: flex; gap: 12px; align-items: center;
    padding: 12px; background: #fff; border: 1px solid var(--line); border-radius: 14px;
  }
  .doc:hover { border-color: var(--cyan); }
  .doc img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
  .doc strong { display: block; font-size: 14px; }
  .doc small { color: var(--muted); font-size: 12px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }
  .card {
    background: #fff; border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
  }
  .card img { width: 100%; height: 180px; object-fit: cover; background: #eef3f5; }
  .card > div { padding: 18px; }
  .card h3 { margin: 0 0 10px; font-size: 18px; }
  .card p { margin: 4px 0; color: #444; font-size: 14px; line-height: 1.55; }
  .phone { color: var(--cyan-hover); font-weight: 600; }
  @media (max-width: 700px) {
    .hero { padding: 44px 0 32px; }
    .page { padding: 28px 0 56px; }
    .hours-grid, .grid { grid-template-columns: 1fr; }
    .wa-btn { width: 100%; }
  }
</style>
