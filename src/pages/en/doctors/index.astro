---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import doctors from '../../../data/doctors.json';
import services from '../../../data/services.json';
import site from '../../../data/site.json';
import { t, deptTitleEn, serviceDesc } from '../../../lib/i18n';

const ui = t('en');

const departmentOrder = [
  'general',
  'respiratory',
  'endocrine',
  'genetics',
  'surgery',
  'neuro',
  'obstetrics',
  'psychology',
];

const serviceIcon = Object.fromEntries(services.map((s) => [s.id, s.icon]));
const fallbackIcon = services[0]?.icon;

const departments = departmentOrder
  .map((id) => {
    const list = doctors.filter((d) => d.department === id);
    if (!list.length) return null;
    const relatedService = services.find((s) => s.id === id);
    const title = deptTitleEn[id] || list[0].departmentTitle;
    return {
      id,
      title,
      count: list.length,
      icon: serviceIcon[id] || fallbackIcon,
      desc: relatedService ? serviceDesc('en', relatedService.id, relatedService.desc) : `${title} specialist team for assessment and follow-up.`,
      doctors: list,
    };
  })
  .filter(Boolean);
---
<BaseLayout title={`${ui.doctorsHeadline} | ${site.nameEn}`} description={ui.doctorsLead}>
  <section class="page-hero">
    <div class="container">
      <h1>{ui.doctorsHeadline}</h1>
      <p>Choose a department, then view its clinicians.</p>
    </div>
  </section>

  <section class="container catalog">
    <div class="intro">
      <h2>Choose a department</h2>
      <p>{departments.length} departments — open one to see its team.</p>
    </div>
    <div class="grid">
      {departments.map((d) => (
        <a class="card" href={`/en/doctors/${d.id}/`}>
          {d.icon && <img src={d.icon} alt="" />}
          <div>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <div class="faces">
              {d.doctors.slice(0, 4).map((doc) => (
                <img src={doc.image} alt="" />
              ))}
            </div>
            <em>{d.count} members →</em>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 64px 0 36px;
    background: linear-gradient(180deg, #e8f7f9, transparent);
  }
  .page-hero h1 { margin: 0; font-size: clamp(2rem, 4vw, 2.8rem); }
  .page-hero p { margin: 14px 0 0; color: #444; max-width: 640px; line-height: 1.7; }
  .catalog { padding: 28px 0 80px; }
  .intro { margin-bottom: 22px; }
  .intro h2 { margin: 0; font-size: 24px; }
  .intro p { margin: 8px 0 0; color: var(--muted); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }
  .card {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: #c5e4ea;
  }
  .card > img { width: 56px; height: 56px; object-fit: contain; }
  .card h3 { margin: 0; font-size: 18px; }
  .card p { margin: 8px 0 12px; color: var(--muted); font-size: 14px; line-height: 1.5; min-height: 42px; }
  .faces { display: flex; gap: 6px; margin-bottom: 12px; }
  .faces img {
    width: 32px; height: 32px; border-radius: 50%; object-fit: cover;
    border: 2px solid #fff; box-shadow: 0 0 0 1px var(--line);
  }
  .card em { font-style: normal; color: var(--cyan); font-size: 13px; font-weight: 600; }
  @media (max-width: 700px) {
    .page-hero { padding: 40px 0 24px; }
    .page-hero h1 { font-size: 1.7rem; }
    .catalog { padding: 16px 0 56px; }
    .grid { grid-template-columns: 1fr; gap: 10px; }
    .card {
      grid-template-columns: 44px 1fr;
      gap: 12px;
      padding: 16px;
    }
    .card > img { width: 44px; height: 44px; }
    .card p { min-height: 0; margin: 6px 0 10px; font-size: 13px; }
  }
</style>
