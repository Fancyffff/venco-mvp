---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import education from '../../../../../data/education.json';
import doctors from '../../../../../data/doctors.json';
import site from '../../../../../data/site.json';
import { blocksFromBody } from '../../../../../lib/education-body';
import { t, categoryCopyEn } from '../../../../../lib/i18n';

const ui = t('en');

export function getStaticPaths() {
  return education.map((article) => ({
    params: { category: article.category, slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const related = article.related
  .map((r) => education.find((e) => e.slug === r.slug))
  .filter(Boolean);
const paperImages = article.images.filter((src) => src.includes('attachment') || article.images.length > 1);
const showPaper = paperImages.length > 0 && article.body.length < 8;
const articleDoctor = doctors.find((d) => d.name === article.doctorName);
const doctorHref = articleDoctor
  ? `/en/doctors/${articleDoctor.department}/#${articleDoctor.id}`
  : '/en/doctors/';
const categoryHref = `/en/education/${article.category}/`;
const bodyBlocks = blocksFromBody(article.body || []);
const catTitle = categoryCopyEn[article.category]?.title || article.categoryTitle || article.tag;

---
<BaseLayout title={`${article.title} | ${site.nameEn}`} description={article.lead || article.title}>
  <article class="page">
    <div class="container">
      <p class="crumb">
        <a href="/en/education/">{ui.education}</a>
        <span>/</span>
        <a href={categoryHref}>{catTitle}</a>
        <span>/</span>
        <strong>Article</strong>
      </p>

      <header class="head">
        {(article.categoryTitle || article.tag) && (
          <a class="tag" href={categoryHref}>{catTitle}</a>
        )}
        <h1>{article.title}</h1>
        {article.lead && <p class="lead">{article.lead}</p>}
        <div class="meta">
          {article.doctorName && (
            <a class="doc" href={doctorHref}>
              {article.doctorPortrait && <img src={article.doctorPortrait} alt="" />}
              <span>
                <strong>{article.doctorName}</strong>
                {article.doctorEnglish && <small>{article.doctorEnglish}</small>}
              </span>
            </a>
          )}
          {article.date && <time>{article.date}</time>}
        </div>
      </header>

      {article.videos.map((v) => (
        <div class="video">
          <iframe
            src={v.src}
            title={v.title || article.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        </div>
      ))}

      {showPaper ? (
        <div class="paper">
          {paperImages.map((src) => (
            <img src={src} alt={article.title} loading="lazy" />
          ))}
        </div>
      ) : (
        <div class="content">
          {article.cover && bodyBlocks.length > 0 && !article.videos.length && (
            <img class="cover" src={article.cover} alt="" />
          )}
          {bodyBlocks.map((block) => {
            if (block.type === 'h2') return <h2>{block.text}</h2>;
            if (block.type === 'ul') {
              return (
                <ul>
                  {block.items.map((item) => <li>{item}</li>)}
                </ul>
              );
            }
            return <p>{block.text}</p>;
          })}
          {bodyBlocks.length === 0 && article.videos.length > 0 && (
            <p class="media-note">This article is mainly a video — please watch above.</p>
          )}
          {!showPaper && article.images.filter((s) => s !== article.cover).map((src) => (
            <img class="inline-img" src={src} alt="" loading="lazy" />
          ))}
        </div>
      )}

      <div class="actions">
        <a class="wa-btn" href={article.doctorWhatsapp || site.whatsapp} target="_blank" rel="noreferrer">
          <img src="/assets/whatsapp.svg" alt="" /> {ui.bookWhatsapp}
        </a>
        <a class="ghost" href={categoryHref}>← Back to topic</a>
      </div>

      {related.length > 0 && (
        <section class="related">
          <h2>Related articles</h2>
          <div class="rel-grid">
            {related.map((e) => (
              <a href={`/en/education/${e.category}/${e.slug}/`}>
                {e.cover && <img src={e.cover} alt="" loading="lazy" />}
                <span>{e.title}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .page { padding: 28px 0 72px; }
  .crumb {
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
    margin: 0 0 18px; color: var(--muted); font-size: 13px;
  }
  .crumb a { color: var(--cyan); }
  .head { max-width: 820px; margin-bottom: 24px; }
  .tag {
    display: inline-flex; padding: 4px 10px; border-radius: 999px;
    background: #e8f7f9; color: var(--cyan-hover); font-size: 12px; font-weight: 600;
  }
  h1 { margin: 12px 0 0; font-size: clamp(1.7rem, 4vw, 2.5rem); line-height: 1.25; }
  .lead { margin: 14px 0 0; color: #444; font-size: 16px; line-height: 1.7; }
  .meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 14px;
    margin-top: 18px; color: var(--muted); font-size: 13px;
  }
  .doc {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 12px 6px 6px; border-radius: 999px; background: #f4fafb;
  }
  .doc img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
  .doc strong { display: block; color: #222; font-size: 14px; }
  .doc small { color: var(--muted); font-size: 12px; }
  .video {
    position: relative;
    width: min(860px, 100%);
    aspect-ratio: 16 / 9;
    margin: 0 0 24px;
    border-radius: 16px;
    overflow: hidden;
    background: #111;
  }
  .video iframe { width: 100%; height: 100%; border: 0; }
  .paper {
    display: grid; gap: 12px; max-width: 860px;
  }
  .paper img {
    width: 100%; border-radius: 12px; border: 1px solid var(--line); background: #fff;
  }
  .content { max-width: 760px; }
  .content .cover {
    width: 100%; border-radius: 16px; margin-bottom: 20px; background: #eef3f5;
  }
  .content h2 { margin: 28px 0 10px; font-size: 1.25rem; }
  .content p { margin: 0 0 14px; color: #333; line-height: 1.8; font-size: 15.5px; }
  .content .media-note { color: var(--muted); font-size: 14px; }
  .content ul {
    margin: 0 0 18px;
    padding-left: 1.2em;
    color: #333;
    line-height: 1.75;
    font-size: 15.5px;
  }
  .content li { margin: 6px 0; }
  .inline-img {
    width: 100%; border-radius: 12px; margin: 8px 0 18px; border: 1px solid var(--line);
  }
  .actions {
    display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
    margin-top: 28px;
  }
  .ghost {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px;
    border-radius: 999px; border: 1px solid var(--line); background: #fff; font-weight: 600; font-size: 14px;
  }
  .related { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  .related h2 { margin: 0 0 16px; font-size: 1.25rem; }
  .rel-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px;
  }
  .rel-grid a {
    display: grid; gap: 10px; padding: 12px; border: 1px solid var(--line); border-radius: 14px; background: #fff;
  }
  .rel-grid img {
    width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 10px; background: #eef3f5;
  }
  .rel-grid span { font-size: 14px; line-height: 1.4; font-weight: 600; }
  @media (max-width: 700px) {
    .page { padding: 18px 0 56px; }
    h1 { font-size: 1.45rem; }
    .actions { flex-direction: column; align-items: stretch; }
    .actions .wa-btn, .actions .ghost { width: 100%; justify-content: center; }
  }
</style>
