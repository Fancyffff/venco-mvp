---
import BaseLayout from '../../layouts/BaseLayout.astro';
import services from '../../data/services.json';
import doctors from '../../data/doctors.json';
import site from '../../data/site.json';
import { t, serviceTitle, serviceDesc } from '../../lib/i18n';

const ui = t('en');
const featuredDoctors = doctors.slice(0, 8);
const homeLead = site.homeLeadEn || site.homeLead;
const educationCards = site.education.map((e) => ({
  ...e,
  href: e.href.replace('/zh/', '/en/'),
}));
---
<BaseLayout title={`${site.nameEn} | Home`} description={ui.siteDesc}>
  <section class="hero" style={`--hero:url(${site.homeHero})`}>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{site.nameEn}<br />{ui.homeHeadline}</h1>
        {homeLead.map((p) => <p>{p}</p>)}
        <div class="hero-actions">
          <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
            <img src="/assets/whatsapp.svg" alt="" /> {ui.bookWhatsapp}
          </a>
          <a class="ghost" href="/en/about/">{ui.about}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{ui.servicesHeadline}</h2>
          <p>{ui.servicesLead}</p>
        </div>
        <a class="text-link" href="/en/services/">{ui.viewAllServices}</a>
      </div>
      <div class="service-grid">
        {services.map((s) => (
          <a class="service-card" href={`/en/services/${s.id}/`}>
            <img src={s.icon} alt="" />
            <h3>{serviceTitle('en', s.id, s.title)}</h3>
            <p>{serviceDesc('en', s.id, s.desc)}</p>
            <span>{ui.learnMore}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{ui.doctorsHeadline}</h2>
          <p>{ui.doctorsLead}</p>
        </div>
        <a class="text-link" href="/en/doctors/">{ui.viewAllDoctors}</a>
      </div>
      <div class="rail-wrap">
        <button class="rail-btn prev" type="button" data-rail-prev aria-label="Previous doctors">‹</button>
        <div class="doctor-rail" data-doctor-rail>
          {featuredDoctors.map((d) => (
            <a class="doctor-card" href={`/en/doctors/${d.department}/#${d.id}`}>
              <img src={d.image} alt={d.english || d.name} />
              <div class="doctor-body">
                <h3>{d.english || d.name}</h3>
                <p class="en">{d.name}</p>
                <p class="title">{d.title}</p>
                {d.role && <p class="role">{d.role}</p>}
                <span>{ui.learnMore}</span>
              </div>
            </a>
          ))}
        </div>
        <button class="rail-btn next" type="button" data-rail-next aria-label="Next doctors">›</button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{ui.educationHeadline}</h2>
          <p>{ui.educationLead}</p>
        </div>
        <a class="text-link" href="/en/education/">{ui.viewAllEducation}</a>
      </div>
      <div class="edu-grid">
        {educationCards.map((e) => (
          <a class="edu-card" href={e.href}>
            <div class="edu-media">
              <img src={e.image} alt="" />
              <span class="tag">{e.tag}</span>
            </div>
            <div class="edu-body">
              <h3>{e.title}</h3>
              <p>{e.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Comfortable clinics</h2>
          <p>Warm, child-friendly spaces for care and follow-up</p>
        </div>
        <a class="text-link" href="/en/about/#environment">View clinic environment →</a>
      </div>

      <div class="clinic-stack">
        {site.locations.map((loc, i) => {
          const en = site.locationsEn?.[i];
          const name = en?.name || loc.name;
          const address = en?.address || loc.address;
          return (
            <a class="clinic-teaser" href="/en/about/#environment">
              <img src={loc.receptionImage || loc.gallery[0]} alt={`${name} clinic`} />
              <div>
                <h3>{name}</h3>
                <p>{address}</p>
                <p class="phone">{loc.phone}</p>
                <span>View environment and map →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>{ui.contactCta}</h2>
        <p>{ui.contactCtaLead}</p>
      </div>
      <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
        <img src="/assets/whatsapp.svg" alt="" /> {ui.bookWhatsapp}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 580px;
    display: flex;
    align-items: center;
    background:
      linear-gradient(180deg, rgba(255,255,255,.92) 0%, rgba(255,255,255,.78) 52%, rgba(255,255,255,.55) 100%),
      var(--hero) center right / cover no-repeat;
  }
  .hero-inner {
    width: 100%;
    padding: 64px 0;
    display: flex;
    justify-content: center;
    text-align: center;
  }
  .hero-copy { max-width: 720px; }
  .hero h1 {
    margin: 0;
    font-size: clamp(1.9rem, 5.2vw, 3.2rem);
    line-height: 1.18;
    letter-spacing: -.02em;
  }
  .hero p {
    margin: 14px 0 0;
    color: #333;
    line-height: 1.75;
    font-size: 15px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .ghost {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0 18px; border-radius: 999px;
    background: rgba(255,255,255,.92); border: 1px solid var(--line);
    font-weight: 600; font-size: 14px;
  }
  .ghost:hover { border-color: var(--cyan); color: var(--cyan); }

  .section { padding: 72px 0; }
  .section.soft { background: var(--soft); }
  .section-head {
    display: flex; justify-content: space-between; align-items: end;
    gap: 16px; margin-bottom: 28px;
  }
  .section-head h2 { margin: 0; font-size: clamp(1.5rem, 3.2vw, 2rem); }
  .section-head p { margin: 8px 0 0; color: var(--muted); font-size: 15px; }
  .text-link { color: var(--cyan); font-weight: 600; white-space: nowrap; font-size: 14px; }
  .text-link:hover { text-decoration: underline; }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .service-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 20px 16px 18px;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: #c5e4ea;
  }
  .service-card img { width: 56px; height: 56px; object-fit: contain; margin-bottom: 14px; }
  .service-card h3 { margin: 0; font-size: 15px; line-height: 1.35; }
  .service-card p { margin: 8px 0 16px; color: var(--muted); font-size: 13px; min-height: 42px; line-height: 1.5; }
  .service-card span { color: var(--cyan); font-size: 13px; font-weight: 600; }

  .rail-wrap { position: relative; }
  .doctor-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 270px);
    gap: 16px;
    overflow-x: auto;
    padding: 4px 2px 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .doctor-rail::-webkit-scrollbar { display: none; }
  .rail-btn {
    position: absolute;
    top: 42%;
    z-index: 2;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow);
    font-size: 26px;
    line-height: 1;
    color: var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rail-btn.prev { left: -8px; }
  .rail-btn.next { right: -8px; }
  .doctor-card {
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    transition: box-shadow .16s ease, transform .16s ease;
  }
  .doctor-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .doctor-card > img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #eef3f5;
  }
  .doctor-body { padding: 14px 16px 18px; }
  .doctor-body h3 { margin: 0; font-size: 17px; }
  .doctor-body .en { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
  .doctor-body .title { margin: 8px 0 0; color: var(--cyan-hover); font-weight: 600; font-size: 13px; }
  .doctor-body .role { margin: 4px 0 0; color: #555; font-size: 12px; line-height: 1.45; }
  .doctor-body span { display: inline-block; margin-top: 12px; color: var(--cyan); font-size: 13px; font-weight: 600; }

  .edu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .edu-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    transition: box-shadow .16s ease, transform .16s ease;
  }
  .edu-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .edu-media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #eef3f5;
  }
  .edu-media img { width: 100%; height: 100%; object-fit: cover; }
  .edu-media .tag {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,.94);
    color: var(--cyan-hover);
    font-size: 12px;
    font-weight: 600;
  }
  .edu-body { padding: 16px 18px 18px; }
  .edu-body h3 { margin: 0 0 8px; font-size: 16px; line-height: 1.4; }
  .edu-body p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.55; }

  .clinic-stack {
    display: grid;
    gap: 16px;
  }
  .clinic-teaser {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    transition: box-shadow .16s ease, transform .16s ease, border-color .16s ease;
  }
  .clinic-teaser:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    border-color: #c5e4ea;
  }
  .clinic-teaser img {
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
    background: #eef3f5;
  }
  .clinic-teaser > div { padding: 24px 26px; display: flex; flex-direction: column; justify-content: center; }
  .clinic-teaser h3 { margin: 0 0 10px; font-size: 22px; }
  .clinic-teaser p { margin: 6px 0; color: #444; font-size: 14px; line-height: 1.55; }
  .clinic-teaser .phone { color: var(--cyan-hover); font-weight: 600; }
  .clinic-teaser span { margin-top: 14px; color: var(--cyan); font-weight: 600; font-size: 14px; }

  .cta-band {
    background: linear-gradient(90deg, #e7f9fb, #f3fcff);
    border-top: 1px solid var(--line);
    padding: 44px 0;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .cta-inner h2 { margin: 0; font-size: 1.55rem; }
  .cta-inner p { margin: 6px 0 0; color: var(--muted); }

  @media (max-width: 1100px) {
    .service-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .edu-grid { grid-template-columns: 1fr; }
    .clinic-teaser { grid-template-columns: 1fr; }
    .clinic-teaser img { min-height: 180px; max-height: 220px; }
    .rail-btn { display: none; }
  }
  @media (max-width: 700px) {
    .hero {
      min-height: auto;
      align-items: flex-end;
      background:
        linear-gradient(180deg, rgba(255,255,255,.12) 0%, rgba(255,255,255,.82) 52%, #fff 100%),
        var(--hero) 68% center / cover no-repeat;
    }
    .hero-inner { padding: 130px 0 28px; }
    .hero-copy {
      background: rgba(255,255,255,.96);
      border-radius: 18px;
      padding: 20px 16px;
      box-shadow: var(--shadow);
    }
    .hero p { font-size: 14px; }
    .hero-actions { gap: 8px; }
    .hero-actions .wa-btn,
    .hero-actions .ghost { flex: 1 1 auto; }
    .section { padding: 44px 0; }
    .section-head { flex-direction: column; align-items: start; gap: 10px; margin-bottom: 18px; }
    .service-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .service-card { padding: 14px 12px; }
    .service-card img { width: 44px; height: 44px; margin-bottom: 10px; }
    .service-card p { display: none; }
    .doctor-rail { grid-auto-columns: minmax(220px, 78vw); }
    .cta-inner { flex-direction: column; align-items: stretch; }
    .cta-inner .wa-btn { width: 100%; }
  }
  @media (max-width: 380px) {
    .service-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const rail = document.querySelector('[data-doctor-rail]');
  document.querySelector('[data-rail-prev]')?.addEventListener('click', () => {
    rail?.scrollBy({ left: -280, behavior: 'smooth' });
  });
  document.querySelector('[data-rail-next]')?.addEventListener('click', () => {
    rail?.scrollBy({ left: 280, behavior: 'smooth' });
  });
</script>
