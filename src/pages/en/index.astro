---
import BaseLayout from '../../layouts/BaseLayout.astro';
import services from '../../data/services.json';
import doctors from '../../data/doctors.json';
import site from '../../data/site.json';
import education from '../../data/education.json';
import { t, serviceTitle, serviceDesc } from '../../lib/i18n';

const ui = t('en');
const featuredDoctors = doctors.slice(0, 8);
const homeLead = site.homeLeadEn || site.homeLead;
const videoArticleHrefs = new Set(
  education.filter((article) => article.videos?.length).map((article) => `/education/${article.category}/${article.slug}/`),
);
const educationCards = site.education.map((e) => ({
  ...e,
  href: `/en${e.href}`,
  hasVideo: videoArticleHrefs.has(e.href),
}));
---
<BaseLayout title={`${site.nameEn} | Home`} description={ui.siteDesc}>
  <section class="hero" style={`--hero:url(${site.homeHero})`}>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{site.nameEn}<br />{ui.homeHeadline}</h1>
        {homeLead.map((p) => <p>{p}</p>)}
        <div class="hero-actions">
          <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
            <img src="/assets/whatsapp.svg" alt="" /> {ui.bookWhatsapp}
          </a>
          <a class="ghost" href="/en/about/">{ui.about}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{ui.servicesHeadline}</h2>
          <p>{ui.servicesLead}</p>
        </div>
        <a class="text-link" href="/en/services/">{ui.viewAllServices}</a>
      </div>
      <div class="service-grid">
        {services.map((s) => (
          <a class="service-card" href={`/en/services/${s.id}/`}>
            <img src={s.icon} alt="" />
            <h3>{serviceTitle('en', s.id, s.title)}</h3>
            <p>{serviceDesc('en', s.id, s.desc)}</p>
            <span aria-hidden="true">{ui.learnMore} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{ui.doctorsHeadline}</h2>
          <p>{ui.doctorsLead}</p>
        </div>
        <a class="text-link" href="/en/doctors/">{ui.viewAllDoctors}</a>
      </div>
      <div class="rail-wrap">
        <button class="rail-btn prev" type="button" data-rail-prev aria-label="Previous doctors">‹</button>
        <div class="doctor-rail" data-doctor-rail>
          {featuredDoctors.map((d) => (
            <a class="doctor-card" href={`/en/doctors/${d.department}/#${d.id}`}>
              <img src={d.image} alt={d.english || d.name} />
              <div class="doctor-body">
                <h3>{d.english || d.name}</h3>
                <p class="en">{d.name}</p>
                <p class="title">{d.title}</p>
                {d.role && <p class="role">{d.role}</p>}
                <span>{ui.learnMore}</span>
              </div>
            </a>
          ))}
        </div>
        <button class="rail-btn next" type="button" data-rail-next aria-label="Next doctors">›</button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{ui.educationHeadline}</h2>
          <p>{ui.educationLead}</p>
        </div>
        <a class="text-link" href="/en/education/">{ui.viewAllEducation}</a>
      </div>
      <div class="edu-grid">
        {educationCards.map((e) => (
          <a class="edu-card" href={e.href}>
            <div class="edu-media">
              <img src={e.image} alt="" />
              <span class="tag">{e.tag}</span>
              {e.hasVideo && <span class="play" aria-hidden="true">▶</span>}
            </div>
            <div class="edu-body">
              <h3>{e.title}</h3>
              <p>{e.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Comfortable clinics</h2>
          <p>Warm, child-friendly spaces for care and follow-up</p>
        </div>
        <a class="text-link" href="/en/about/#environment">View clinic environment →</a>
      </div>

      <div class="clinic" data-clinic>
        <div class="clinic-tabs" role="tablist" aria-label="Clinic locations">
          {site.locations.map((loc, i) => {
            const en = site.locationsEn?.[i];
            const name = en?.name || loc.name;
            return (
              <button
                type="button"
                class:list={['clinic-tab', { active: i === 0 }]}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-clinic-tab={i}
              >
                {name}
              </button>
            );
          })}
        </div>

        {site.locations.map((loc, i) => {
          const en = site.locationsEn?.[i];
          const name = en?.name || loc.name;
          const address = en?.address || loc.address;
          return (
            <div class:list={['clinic-panel', { show: i === 0 }]} data-clinic-panel={i}>
              <div class="clinic-gallery" data-gallery>
                <div class="gallery-main">
                  <img src={loc.gallery[0]} alt={`${name} clinic`} data-gallery-main />
                  <button type="button" class="g-btn prev" data-g-prev aria-label="Previous photo">‹</button>
                  <button type="button" class="g-btn next" data-g-next aria-label="Next photo">›</button>
                </div>
                <div class="gallery-thumbs">
                  {loc.gallery.map((src, gi) => (
                    <button type="button" class:list={['thumb', { active: gi === 0 }]} data-g-thumb={gi}>
                      <img src={src} alt="" />
                    </button>
                  ))}
                </div>
              </div>
              <div class="clinic-info">
                <h3>{name}</h3>
                <p>{address}</p>
                <p class="phone">{loc.phone}</p>
                {loc.fax && <p>Fax {loc.fax}</p>}
                <img class="map" src={loc.mapImage} alt={`${name} map`} />
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>{ui.contactCta}</h2>
        <p>{ui.contactCtaLead}</p>
      </div>
      <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
        <img src="/assets/whatsapp.svg" alt="" /> {ui.bookWhatsapp}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: max(580px, calc(100vh - 82px));
    display: flex;
    align-items: flex-start;
    background:
      linear-gradient(90deg, rgba(255,255,255,.90) 0%, rgba(255,255,255,.45) 42%, rgba(255,255,255,.04) 68%, rgba(255,255,255,0) 82%),
      var(--hero) center right / cover no-repeat;
  }
  .hero-inner {
    padding: clamp(120px, 26vh, 200px) 0 56px;
  }
  .hero-copy { max-width: 600px; }
  .hero h1 {
    margin: 0;
    font-size: clamp(1.9rem, 5.2vw, 3.1rem);
    line-height: 1.18;
    letter-spacing: -.02em;
  }
  .hero p {
    margin: 18px 0 0;
    color: #333;
    line-height: 1.65;
    font-size: 18px;
  }
  .hero-actions {
    display: flex;
    gap: 22px;
    margin-top: 62px;
    flex-wrap: wrap;
  }
  .hero-actions .wa-btn,
  .hero-actions .ghost {
    min-height: 48px;
  }
  .hero-actions .wa-btn {
    padding-inline: 34px;
  }
  .hero-actions .ghost {
    padding-inline: 22px;
  }
  .ghost {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0 18px; border-radius: 999px;
    background: rgba(255,255,255,.92); border: 1px solid var(--line);
    font-weight: 600; font-size: 14px;
  }
  .ghost:hover { border-color: var(--cyan); color: var(--cyan); }

  .section { padding: 72px 0; }
  .section.soft { background: var(--soft); }
  .services-section { background: var(--soft); }
  .services-section .container { width: min(1420px, calc(100% - 64px)); }
  .services-section .section-head h2 { font-size: clamp(1.8rem, 3vw, 2.35rem); }
  .section-head {
    display: flex; justify-content: space-between; align-items: end;
    gap: 16px; margin-bottom: 28px;
  }
  .section-head h2 { margin: 0; font-size: clamp(1.5rem, 3.2vw, 2rem); }
  .section-head p { margin: 8px 0 0; color: var(--muted); font-size: 15px; }
  .text-link { color: var(--cyan); font-weight: 600; white-space: nowrap; font-size: 14px; }
  .text-link:hover { text-decoration: underline; }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  .service-card {
    position: relative;
    display: flex;
    min-height: 280px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #fff;
    border: 1px solid rgba(211, 231, 235, .9);
    border-radius: 20px;
    padding: 28px 18px 24px;
    box-shadow: 0 6px 18px rgba(0, 62, 73, .07);
    overflow: hidden;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .service-card:hover,
  .service-card:focus-visible {
    transform: translateY(-8px);
    box-shadow: 0 18px 38px rgba(0, 132, 150, .18);
    border-color: rgba(0, 177, 195, .55);
    outline: none;
  }
  .service-card img { width: 100px; height: 100px; object-fit: contain; margin-bottom: 24px; transition: transform .25s ease; }
  .service-card:hover img,
  .service-card:focus-visible img { transform: translateY(-4px) scale(1.08); }
  .service-card h3 { margin: 0; font-size: 18px; line-height: 1.35; transition: color .2s ease; }
  .service-card:hover h3,
  .service-card:focus-visible h3 { color: var(--cyan-hover); }
  .service-card p { margin: 10px 0 0; color: #8b8b8b; font-size: 13px; min-height: 40px; line-height: 1.55; }
  .service-card span { position: absolute; right: 18px; bottom: 14px; color: var(--cyan); font-size: 12px; font-weight: 700; opacity: 0; transform: translateX(-6px); transition: opacity .2s ease, transform .2s ease; }
  .service-card:hover span,
  .service-card:focus-visible span { opacity: 1; transform: none; }

  .rail-wrap { position: relative; }
  .doctor-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 270px);
    gap: 16px;
    overflow-x: auto;
    padding: 4px 2px 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .doctor-rail::-webkit-scrollbar { display: none; }
  .rail-btn {
    position: absolute;
    top: 42%;
    z-index: 2;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow);
    font-size: 26px;
    line-height: 1;
    color: var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rail-btn.prev { left: -8px; }
  .rail-btn.next { right: -8px; }
  .doctor-card {
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    transition: box-shadow .16s ease, transform .16s ease;
  }
  .doctor-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .doctor-card > img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #eef3f5;
  }
  .doctor-body { padding: 14px 16px 18px; }
  .doctor-body h3 { margin: 0; font-size: 17px; }
  .doctor-body .en { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
  .doctor-body .title { margin: 8px 0 0; color: var(--cyan-hover); font-weight: 600; font-size: 13px; }
  .doctor-body .role { margin: 4px 0 0; color: #555; font-size: 12px; line-height: 1.45; }
  .doctor-body span { display: inline-block; margin-top: 12px; color: var(--cyan); font-size: 13px; font-weight: 600; }

  .edu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .edu-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    transition: box-shadow .16s ease, transform .16s ease;
  }
  .edu-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .edu-media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #eef3f5;
  }
  .edu-media img { width: 100%; height: 100%; object-fit: cover; }
  .edu-media .tag {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,.94);
    color: var(--cyan-hover);
    font-size: 12px;
    font-weight: 600;
  }
  .edu-media .play {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    padding-left: 3px;
    border-radius: 50%;
    background: rgba(20, 20, 20, .62);
    color: #fff;
    font-size: 21px;
    transform: translate(-50%, -50%);
    transition: transform .16s ease, background .16s ease;
  }
  .edu-card:hover .play,
  .edu-card:focus-visible .play {
    background: rgba(0, 174, 190, .9);
    transform: translate(-50%, -50%) scale(1.08);
  }
  .edu-body { padding: 16px 18px 18px; }
  .edu-body h3 { margin: 0 0 8px; font-size: 16px; line-height: 1.4; }
  .edu-body p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.55; }

  .clinic-tabs {
    display: inline-flex;
    gap: 8px;
    padding: 4px;
    background: #e8f1f3;
    border-radius: 999px;
    margin-bottom: 20px;
  }
  .clinic-tab {
    min-height: 40px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #556;
    font-weight: 600;
    font-size: 14px;
  }
  .clinic-tab.active {
    background: #fff;
    color: var(--cyan-hover);
    box-shadow: 0 2px 10px rgba(0,40,50,.08);
  }
  .clinic-panel { display: none; grid-template-columns: 1.35fr 1fr; gap: 20px; align-items: start; }
  .clinic-panel.show { display: grid; }
  .gallery-main {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: #eef3f5;
    aspect-ratio: 16 / 10;
  }
  .gallery-main img { width: 100%; height: 100%; object-fit: cover; }
  .g-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,.92);
    color: var(--cyan);
    font-size: 24px;
    box-shadow: var(--shadow);
  }
  .g-btn.prev { left: 12px; }
  .g-btn.next { right: 12px; }
  .gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 10px;
  }
  .thumb {
    border: 2px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    padding: 0;
    background: #eef3f5;
    aspect-ratio: 16 / 10;
  }
  .thumb.active { border-color: var(--cyan); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .clinic-info {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px;
  }
  .clinic-info h3 { margin: 0 0 10px; font-size: 22px; }
  .clinic-info p { margin: 6px 0; color: #444; font-size: 14px; line-height: 1.55; }
  .clinic-info .phone { color: var(--cyan-hover); font-weight: 600; }
  .clinic-info .map {
    margin-top: 16px;
    width: 100%;
    border-radius: 12px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #eef3f5;
  }

  .cta-band {
    background: linear-gradient(to bottom, var(--soft) 0 50%, var(--cyan) 50% 100%);
    padding: 64px 0 0;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    min-height: 180px;
    padding: 38px clamp(28px, 8vw, 120px);
    border-radius: 22px;
    background: var(--action);
    box-shadow: 0 14px 34px rgba(0, 77, 88, .16);
    width: min(1320px, calc(100% - 64px));
  }
  .cta-inner h2 { margin: 0; font-size: clamp(1.55rem, 3vw, 2rem); }
  .cta-inner p { margin: 10px 0 0; color: #376f77; }
  .cta-inner .wa-btn { min-width: 230px; min-height: 54px; background: rgba(255,255,255,.86); }

  @media (max-width: 1100px) {
    .service-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .edu-grid { grid-template-columns: 1fr; }
    .clinic-panel.show { grid-template-columns: 1fr; }
    .rail-btn { display: none; }
  }
  @media (max-width: 700px) {
    .hero {
      min-height: auto;
      align-items: center;
      text-align: center;
      background:
        linear-gradient(180deg, rgba(247,234,223,.52) 0%, rgba(247,234,223,.9) 30%, rgba(247,234,223,.93) 72%, rgba(247,234,223,.99) 100%),
        var(--hero) 72% center / cover no-repeat;
      border-bottom: 1px solid var(--warm-deep);
    }
    .hero-inner { padding: 44px 14px 40px; }
    .hero-copy {
      max-width: none;
      background: none;
      border-radius: 0;
      padding: 0;
      box-shadow: none;
    }
    .hero h1 {
      font-size: clamp(1.85rem, 8vw, 2.3rem);
      text-shadow: 0 1px 0 rgba(255,255,255,.6);
    }
    .hero p {
      font-size: 14.5px;
      color: var(--warm-ink);
      margin-top: 12px;
    }
    .hero-actions {
      gap: 10px;
      margin-top: 24px;
      justify-content: center;
    }
    .hero-actions .wa-btn,
    .hero-actions .ghost {
      flex: 1 1 0;
      min-width: 0;
      min-height: 50px;
      font-size: 14.5px;
      font-weight: 700;
      padding: 0 12px;
    }
    .hero-actions .wa-btn {
      box-shadow: 0 6px 18px rgba(0, 150, 170, .28);
    }
    .hero-actions .ghost {
      background: rgba(255,255,255,.62);
      border: 1px solid var(--warm-line);
      color: var(--warm-ink);
      box-shadow: 0 4px 14px rgba(140, 105, 70, .12);
    }
    .section { padding: 44px 0; }
    .services-section .container { width: calc(100% - 28px); }
    .section-head { flex-direction: column; align-items: start; gap: 10px; margin-bottom: 18px; }
    .service-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .service-card { min-height: 170px; padding: 20px 12px; }
    .service-card img { width: 58px; height: 58px; margin-bottom: 14px; }
    .service-card h3 { font-size: 15px; }
    .service-card p { display: none; }
    .service-card span { display: none; }
    .doctor-rail { grid-auto-columns: minmax(220px, 78vw); }
    .clinic-tabs { width: 100%; display: grid; grid-template-columns: 1fr 1fr; }
    .gallery-thumbs { grid-template-columns: repeat(4, 1fr); }
    .cta-band { padding-top: 36px; }
    .cta-inner { flex-direction: column; align-items: stretch; min-height: 0; padding: 28px 22px; text-align: center; }
    .cta-inner { width: calc(100% - 28px); }
    .cta-inner .wa-btn { width: 100%; }
  }
  @media (max-width: 380px) {
    .service-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card img,
    .service-card span { transition: none; }
  }
</style>

<script>
  const rail = document.querySelector('[data-doctor-rail]');
  document.querySelector('[data-rail-prev]')?.addEventListener('click', () => {
    rail?.scrollBy({ left: -280, behavior: 'smooth' });
  });
  document.querySelector('[data-rail-next]')?.addEventListener('click', () => {
    rail?.scrollBy({ left: 280, behavior: 'smooth' });
  });

  const clinic = document.querySelector('[data-clinic]');
  clinic?.querySelectorAll('[data-clinic-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-clinic-tab');
      clinic.querySelectorAll('[data-clinic-tab]').forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
      });
      clinic.querySelectorAll('[data-clinic-panel]').forEach((panel) => {
        panel.classList.toggle('show', panel.getAttribute('data-clinic-panel') === idx);
      });
    });
  });

  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    const main = gallery.querySelector('[data-gallery-main]');
    const thumbs = [...gallery.querySelectorAll('[data-g-thumb]')];
    let index = 0;
    const show = (i) => {
      index = (i + thumbs.length) % thumbs.length;
      const src = thumbs[index]?.querySelector('img')?.getAttribute('src');
      if (src && main) main.setAttribute('src', src);
      thumbs.forEach((t, ti) => t.classList.toggle('active', ti === index));
    };
    gallery.querySelector('[data-g-prev]')?.addEventListener('click', () => show(index - 1));
    gallery.querySelector('[data-g-next]')?.addEventListener('click', () => show(index + 1));
    thumbs.forEach((t, ti) => t.addEventListener('click', () => show(ti)));
  });
</script>
