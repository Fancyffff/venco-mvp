---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import services from '../../../data/services.json';
import site from '../../../data/site.json';
import documents from '../../../data/documents.json';
import { t, serviceTitle, serviceDesc } from '../../../lib/i18n';

const ui = t('en');
---
<BaseLayout title={`${ui.servicesHeadline} | ${site.nameEn}`} description={ui.servicesLead}>
  <section class="page-hero" style={`--hero:url(${site.servicesHero})`}>
    <div class="container">
      <h1>{ui.servicesHeadline}</h1>
      <p>{ui.servicesLead}. Choose a specialty to view service items and related doctors.</p>
    </div>
  </section>

  <section class="container catalog">
    <div class="intro">
      <h2>Choose a specialty</h2>
      <p>{services.length} specialties — open one to see items and doctors.</p>
    </div>
    <div class="grid">
      {services.map((s) => (
        <a class="card" href={`/en/services/${s.id}/`}>
          <img src={s.icon} alt="" />
          <div>
            <h3>{serviceTitle('en', s.id, s.title)}</h3>
            <p>{serviceDesc('en', s.id, s.desc)}</p>
            <em>
              {s.items.length > 0 ? ui.itemsCount(s.items.length) : ui.specialtyIntro}
              {s.doctorIds.length > 0 ? ` · ${ui.doctorsCount(s.doctorIds.length)}` : ''}
              →
            </em>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container docs" id="documents">
    <div class="docs-head">
      <div>
        <h2>{documents.titleEn}</h2>
        <p>{documents.leadEn}</p>
      </div>
      <a class="doc-entry solid" href="#documents">{ui.browseFiles}</a>
    </div>
    {documents.files.length > 0 ? (
      <ul class="file-list">
        {documents.files.map((file) => (
          <li>
            <span>{file.nameEn || file.name}</span>
            <a href={file.href} download>{ui.downloadFile}</a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="file-empty">
        <p>{ui.noFilesYet}</p>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 80px 0 64px;
    background:
      linear-gradient(90deg, rgba(255,255,255,.94), rgba(255,255,255,.35)),
      var(--hero, none) center right / cover no-repeat;
  }
  .page-hero h1 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); }
  .page-hero p { margin: 14px 0 0; max-width: 560px; color: #333; font-size: 16px; line-height: 1.7; }
  .catalog { padding: 48px 0 80px; }
  .intro { margin-bottom: 24px; }
  .intro h2 { margin: 0; font-size: 24px; }
  .intro p { margin: 8px 0 0; color: var(--muted); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }
  .card {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: #c5e4ea;
  }
  .card img { width: 56px; height: 56px; object-fit: contain; }
  .card h3 { margin: 0; font-size: 18px; }
  .card p { margin: 8px 0 12px; color: var(--muted); font-size: 14px; line-height: 1.5; min-height: 42px; }
  .card em { font-style: normal; color: var(--cyan); font-size: 13px; font-weight: 600; }
  .doc-entry {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 20px; min-height: 42px; padding: 0 16px;
    border-radius: 999px; border: 1px solid var(--cyan); color: var(--cyan-hover);
    background: #fff; font-weight: 700; font-size: 14px;
  }
  .doc-entry:hover { background: var(--cyan-soft); }
  .doc-entry.solid { margin-top: 0; background: var(--cyan); color: #fff; border-color: var(--cyan); }
  .doc-entry.solid:hover { background: var(--cyan-hover); color: #fff; }
  .docs { padding: 0 0 80px; }
  #documents { scroll-margin-top: 88px; }
  .docs-head {
    display: flex; justify-content: space-between; align-items: end; gap: 16px;
    margin-bottom: 16px;
  }
  .docs-head h2 { margin: 0; font-size: 24px; }
  .docs-head p { margin: 8px 0 0; color: var(--muted); }
  .file-empty, .file-list {
    padding: 22px; border-radius: 16px; background: #fff; border: 1px dashed var(--line);
  }
  .file-empty p { margin: 0; color: var(--muted); }
  .file-list { list-style: none; margin: 0; display: grid; gap: 10px; border-style: solid; }
  .file-list li {
    display: flex; justify-content: space-between; gap: 12px; align-items: center;
    padding: 12px 0; border-bottom: 1px solid var(--line); color: #333;
  }
  .file-list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .file-list a { color: var(--cyan); font-weight: 700; font-size: 14px; }
  @media (max-width: 700px) {
    /* Same warm palette as the mobile homepage hero; a pure white hero here
       blends into the white list below and reads as one big empty gap. */
    .page-hero {
      padding: 44px 0 36px;
      background:
        linear-gradient(180deg, rgba(247,234,223,.62) 0%, rgba(247,234,223,.93) 100%),
        var(--hero, none) 70% center / cover no-repeat;
      border-bottom: 1px solid var(--warm-deep);
    }
    .page-hero p { color: var(--warm-ink); }
    .page-hero h1 { font-size: 1.75rem; }
    .page-hero p { font-size: 14px; }
    .catalog { padding: 28px 0 56px; }
    .grid { grid-template-columns: 1fr; gap: 12px; }
    .card {
      grid-template-columns: 66px 1fr;
      gap: 14px;
      align-items: start;
      padding: 16px 16px 18px;
      border-radius: 20px;
      background: linear-gradient(155deg, var(--cyan-soft) 0%, #f7fdfd 46%, #fff 100%);
      border-color: #cfe8ed;
      box-shadow: 0 3px 12px rgba(0, 60, 75, .05);
    }
    .card img {
      width: 66px;
      height: 66px;
      padding: 9px;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 2px 8px rgba(0, 60, 75, .07);
    }
    .card h3 { font-size: 17px; }
    .card p { min-height: 0; margin: 6px 0 10px; font-size: 13px; color: #5a6a6e; }
    .card em { font-size: 12.5px; }
  }
</style>
