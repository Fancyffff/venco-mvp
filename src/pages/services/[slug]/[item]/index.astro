---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import services from '../../../../data/services.json';
import doctors from '../../../../data/doctors.json';
import education from '../../../../data/education.json';
import site from '../../../../data/site.json';
import AsthmaDetail from '../../../../components/AsthmaDetail.astro';

export function getStaticPaths() {
  return services.flatMap((s) =>
    s.items.map((item) => ({
      params: { slug: s.id, item: item.slug },
      props: { service: s, item },
    }))
  );
}

const { service, item } = Astro.props;
const doctorMap = Object.fromEntries(doctors.map((d) => [d.id, d]));
const related = service.doctorIds.map((id) => doctorMap[id]).filter(Boolean);
const otherItems = service.items.filter((x) => x.slug !== item.slug);
const relatedEdu = (item.relatedEducation || [])
  .map((r) => education.find((e) => e.slug === r.slug))
  .filter(Boolean);
const isAsthma = service.id === 'respiratory' && item.slug === 'asthma-care';
---
<BaseLayout
  title={`${item.text} | ${service.title} | ${site.name}`}
  description={isAsthma ? '認識兒童哮喘的病徵、成因、診斷、呼氣一氧化氮測試與日常治療管理。' : `${service.title}：${item.text}`}
>
  <section class="crumb container">
    <a href="/services/">兒科服務</a>
    <span>/</span>
    <a href={`/services/${service.id}/`}>{service.title}</a>
    <span>/</span>
    <strong>{item.text}</strong>
  </section>

  <section class="hero container">
    <h1>{item.text}</h1>
    <p class="parent">所屬專科：{service.title}</p>
    <p class="desc">{service.desc}</p>
  </section>

  {isAsthma && (
    <section class="container asthma-block">
      <AsthmaDetail />
    </section>
  )}

  <section class="container panel">
    <h2>如何預約</h2>
    <ul>
      <li>經 WhatsApp 說明孩子情況與希望預約的服務項目，方便安排合適時段</li>
      <li>如需進一步檢查或轉介，醫生會於診症時詳細解釋</li>
      <li>家長如有疑問，可先預約此專科相關醫生諮詢</li>
    </ul>
    <div class="actions">
      <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
        <img src="/assets/whatsapp.svg" alt="" /> WhatsApp 預約此服務
      </a>
      <a class="ghost" href={`/services/${service.id}/`}>返回 {service.title}</a>
    </div>
  </section>

  {related.length > 0 && (
    <section class="container block">
      <h2>可預約醫生</h2>
      <div class="doctors">
        {related.map((d) => (
          <a class="doctor" href={`/doctors/${d.department}/#${d.id}`}>
            <img src={d.image} alt={d.name} />
            <div>
              <strong>{d.name}</strong>
              <small>{d.title}</small>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {relatedEdu.length > 0 && (
    <section class="container block">
      <h2>相關兒科教育</h2>
      <div class="edu">
        {relatedEdu.map((e) => (
          <a href={`/education/${e.category}/${e.slug}/`}>
            {e.cover && <img src={e.cover} alt="" />}
            <span>{e.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {otherItems.length > 0 && (
    <section class="container block">
      <h2>同專科其他細項</h2>
      <div class="others">
        {otherItems.map((x) => (
          <a href={`/services/${service.id}/${x.slug}/`}>{x.text}</a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .crumb {
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
    padding: 28px 0 0; color: var(--muted); font-size: 13px;
  }
  .crumb a { color: var(--cyan); }
  .hero { padding: 28px 0 8px; }
  .hero h1 { margin: 0; font-size: clamp(1.85rem, 4vw, 2.6rem); max-width: 820px; line-height: 1.25; }
  .parent { margin: 14px 0 0; color: var(--cyan-hover); font-weight: 600; font-size: 14px; }
  .desc { margin: 8px 0 0; color: #444; max-width: 720px; line-height: 1.7; }
  .panel {
    margin: 20px 0; padding: 24px; background: #fff; border: 1px solid var(--line); border-radius: 18px;
  }
  .asthma-block { padding-bottom: 8px; }
  .panel h2 { margin: 0 0 12px; font-size: 18px; }
  .panel li { color: #444; line-height: 1.7; margin: 6px 0; }
  .panel ul { margin: 0; padding-left: 18px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; align-items: center; }
  .ghost {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0 16px;
    border-radius: 999px; border: 1px solid var(--line); background: #fff; font-weight: 600; font-size: 14px;
  }
  .ghost:hover { border-color: var(--cyan); color: var(--cyan); }
  .block { padding: 12px 0 40px; }
  .block h2 { margin: 0 0 14px; font-size: 18px; }
  .doctors {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px;
  }
  .doctor {
    display: flex; gap: 12px; align-items: center;
    padding: 12px; background: #fff; border: 1px solid var(--line); border-radius: 14px;
  }
  .doctor:hover { border-color: var(--cyan); }
  .doctor img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
  .doctor strong { display: block; font-size: 14px; }
  .doctor small { color: var(--muted); font-size: 12px; }
  .edu {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px;
  }
  .edu a {
    display: grid; gap: 10px; padding: 12px; background: #fff; border: 1px solid var(--line); border-radius: 14px;
  }
  .edu img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 10px; background: #eef3f5; }
  .edu span { font-size: 14px; font-weight: 600; line-height: 1.4; }
  .others { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 32px; }
  .others a {
    padding: 8px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: 13px;
  }
  .others a:hover { border-color: var(--cyan); color: var(--cyan); }
  @media (max-width: 700px) {
    .hero { padding: 18px 0 4px; }
    .hero h1 { font-size: 1.5rem; }
    .panel { padding: 18px; margin: 14px 0; }
    .actions { flex-direction: column; align-items: stretch; }
    .actions .wa-btn, .actions .ghost { width: 100%; justify-content: center; }
    .doctors { grid-template-columns: 1fr; }
  }
</style>
