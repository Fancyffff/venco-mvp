---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import services from '../../../data/services.json';
import doctors from '../../../data/doctors.json';
import site from '../../../data/site.json';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}

const { service } = Astro.props;
const doctorMap = Object.fromEntries(doctors.map((d) => [d.id, d]));
const related = service.doctorIds.map((id) => doctorMap[id]).filter(Boolean);
const siblings = services.filter((s) => s.id !== service.id).slice(0, 4);
---
<BaseLayout title={`${service.title} | ${site.name}`} description={service.desc}>
  <section class="crumb container">
    <a href="/services/">兒科服務</a>
    <span>/</span>
    <strong>{service.title}</strong>
  </section>

  <section class="hero container">
    <img class="icon" src={service.icon} alt="" />
    <div>
      <h1>{service.title}</h1>
      <p>{service.desc}</p>
    </div>
  </section>

  {service.items.length > 0 ? (
    <section class="container block">
      <div class="block-head">
        <h2>服務細項</h2>
        <p>以下為本專科常見項目，可經 WhatsApp 預約相關醫生。</p>
      </div>
      <div class="items">
        {service.items.map((item) => (
          <div class="item is-static">
            <span class="dot" aria-hidden="true"></span>
            <strong>{item.text}</strong>
          </div>
        ))}
      </div>
    </section>
  ) : null}

  {related.length > 0 && (
    <section class="container block">
      <div class="block-head">
        <h2>相關醫生</h2>
        <p>可預約此專科的醫生與護理團隊。</p>
      </div>
      <div class="doctors">
        {related.map((d) => (
          <a class="doctor" href={`/doctors/${d.department}/#${d.id}`}>
            <img src={d.image} alt={d.name} />
            <div>
              <strong>{d.name}</strong>
              <small>{d.title}</small>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="container cta">
    <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
      <img src="/assets/whatsapp.svg" alt="" /> WhatsApp 預約
    </a>
    <a class="back" href="/services/">← 返回服務總覽</a>
  </section>

  <section class="container more">
    <h2>其他專科</h2>
    <div class="more-grid">
      {siblings.map((s) => (
        <a href={`/services/${s.id}/`}>
          <img src={s.icon} alt="" />
          <span>{s.title}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .crumb {
    display: flex; gap: 8px; align-items: center;
    padding: 28px 0 0; color: var(--muted); font-size: 13px;
  }
  .crumb a { color: var(--cyan); }
  .hero {
    display: grid; grid-template-columns: 80px 1fr; gap: 20px;
    padding: 28px 0 8px; align-items: start;
  }
  .icon { width: 80px; height: 80px; object-fit: contain; }
  .hero h1 { margin: 0; font-size: clamp(1.85rem, 4vw, 2.6rem); }
  .hero p { margin: 12px 0 0; color: #444; max-width: 640px; line-height: 1.7; font-size: 16px; }
  .block { padding: 32px 0; }
  .block-head { margin-bottom: 16px; }
  .block-head h2 { margin: 0; font-size: 22px; }
  .block-head p { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
  .items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 12px;
  }
  .item {
    display: flex; gap: 12px; align-items: start;
    padding: 14px 16px; border-radius: 12px; background: #f6f8f9;
    border: 0;
    cursor: default;
  }
  .item.is-static:hover { border: 0; box-shadow: none; }
  .dot { width: 6px; height: 6px; margin-top: 8px; border-radius: 50%; background: #c5d4d8; flex: 0 0 auto; }
  .item strong { display: block; font-size: 14px; line-height: 1.45; color: #6b7c82; font-weight: 500; }
  .empty { padding: 18px; border-radius: 14px; background: var(--soft); border: 1px dashed var(--line); color: var(--muted); }
  .doctors {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 12px;
  }
  .doctor {
    display: flex; gap: 12px; align-items: center;
    padding: 14px; background: #fff; border: 1px solid var(--line); border-radius: 14px;
  }
  .doctor:hover { border-color: var(--cyan); }
  .doctor img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
  .doctor strong { display: block; font-size: 14px; }
  .doctor small { color: var(--muted); font-size: 12px; }
  .cta { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; padding: 8px 0 36px; }
  .back { color: var(--cyan); font-weight: 600; }
  .more { padding-bottom: 72px; }
  .more h2 { margin: 0 0 14px; font-size: 18px; }
  .more-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
  .more-grid a {
    display: flex; gap: 10px; align-items: center;
    padding: 12px; background: #fff; border: 1px solid var(--line); border-radius: 12px; font-size: 14px;
  }
  .more-grid a:hover { border-color: var(--cyan); color: var(--cyan); }
  .more-grid img { width: 32px; height: 32px; object-fit: contain; }
  @media (max-width: 700px) {
    .crumb { padding-top: 18px; font-size: 12px; flex-wrap: wrap; }
    .hero { grid-template-columns: 52px 1fr; gap: 12px; padding: 20px 0 8px; }
    .icon { width: 52px; height: 52px; }
    .hero h1 { font-size: 1.55rem; }
    .hero p { font-size: 14px; }
    .block { padding: 20px 0; }
    .items { grid-template-columns: 1fr; }
    .doctors { grid-template-columns: 1fr; }
    .more-grid { grid-template-columns: 1fr 1fr; }
    .cta { flex-direction: column; align-items: stretch; }
    .cta .wa-btn { width: 100%; }
  }
</style>
