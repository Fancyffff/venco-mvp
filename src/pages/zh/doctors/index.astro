---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import doctors from '../../../data/doctors.json';
import site from '../../../data/site.json';

const departmentOrder = [
  'general',
  'respiratory',
  'endocrine',
  'genetics',
  'surgery',
  'neuro',
  'obstetrics',
  'psychology',
];

const groups = departmentOrder
  .map((id) => {
    const list = doctors.filter((d) => d.department === id);
    if (!list.length) return null;
    return {
      id,
      title: list[0].departmentTitle,
      doctors: list,
    };
  })
  .filter(Boolean);
---
<BaseLayout title={`專業的醫生團隊 | ${site.name}`}>
  <section class="page-hero">
    <div class="container">
      <h1>專業的醫生團隊</h1>
      <p>由經驗豐富的兒科醫生與專科團隊細心照顧，按科室為您介紹各位成員。</p>
      <nav class="dept-nav" aria-label="科室導航">
        {groups.map((g) => (
          <a href={`#group-${g.id}`}>{g.title}</a>
        ))}
      </nav>
    </div>
  </section>

  <div class="container">
    {groups.map((g) => (
      <section class="group" id={`group-${g.id}`}>
        <div class="group-head">
          <h2>{g.title}</h2>
          <p>{g.doctors.length} 位成員</p>
        </div>
        <div class="list">
          {g.doctors.map((d) => (
            <article class="card" id={d.id}>
              <img src={d.image} alt={d.name} />
              <div class="body">
                <h3>{d.name}</h3>
                <p class="en">{d.english}</p>
                <p class="title">{d.title}</p>
                {d.role && <p class="role">{d.role}</p>}
                <ul>
                  {d.creds.slice(0, 4).map((c) => <li>{c}</li>)}
                </ul>
                <a class="wa-btn" href={d.whatsapp} target="_blank" rel="noreferrer">
                  <img src="/assets/whatsapp.svg" alt="" /> {d.name} WhatsApp 預約
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding: 64px 0 28px;
    background: linear-gradient(180deg, #e8f7f9, transparent);
  }
  .page-hero h1 { margin: 0; font-size: clamp(2rem, 4vw, 2.8rem); }
  .page-hero p { margin: 14px 0 0; color: #444; max-width: 640px; line-height: 1.7; }
  .dept-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .dept-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    color: #445;
    font-size: 13px;
    font-weight: 600;
  }
  .dept-nav a:hover {
    border-color: var(--cyan);
    color: var(--cyan-hover);
    background: var(--cyan-soft);
  }
  .group {
    padding: 28px 0 40px;
    scroll-margin-top: 96px;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  .group-head h2 { margin: 0; font-size: 24px; }
  .group-head p { margin: 0; color: var(--muted); font-size: 13px; }
  .list { display: grid; gap: 16px; }
  .card {
    display: grid; grid-template-columns: 180px 1fr; gap: 22px;
    background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 20px;
    scroll-margin-top: 100px;
  }
  .card:target { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .card > img {
    width: 180px; height: 180px; object-fit: cover; border-radius: 16px; background: #f2f2f2;
  }
  .body h3 { margin: 0; font-size: 22px; }
  .en { margin: 4px 0 0; color: var(--muted); }
  .title { margin: 10px 0 0; font-weight: 600; color: var(--cyan-hover); }
  .role { margin: 4px 0 0; color: #444; font-size: 14px; line-height: 1.5; }
  ul { margin: 14px 0 18px; padding-left: 18px; color: #444; }
  li { margin: 4px 0; font-size: 14px; line-height: 1.5; }
  @media (max-width: 700px) {
    .page-hero { padding: 40px 0 20px; }
    .page-hero h1 { font-size: 1.7rem; }
    .dept-nav { gap: 6px; }
    .dept-nav a { font-size: 12px; min-height: 32px; padding: 0 12px; }
    .group { padding: 18px 0 28px; }
    .group-head h2 { font-size: 20px; }
    .card {
      grid-template-columns: 96px 1fr;
      gap: 14px;
      padding: 14px;
    }
    .card > img {
      width: 96px; height: 96px; border-radius: 14px;
    }
    .body h3 { font-size: 17px; }
    .body ul { margin: 10px 0 14px; }
    .body .wa-btn {
      width: 100%;
      font-size: 13px;
      padding: 0 12px;
    }
  }
  @media (max-width: 420px) {
    .card { grid-template-columns: 1fr; }
    .card > img { width: 100%; height: 220px; }
  }
</style>
