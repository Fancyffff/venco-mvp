---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import education from '../../../data/education.json';
import site from '../../../data/site.json';
---
<BaseLayout title={`兒科教育 | ${site.name}`} description="分享實用兒童健康知識，陪伴家長安心育兒。">
  <section class="page">
    <div class="container">
      <h1>兒科教育</h1>
      <p class="lead">分享實用兒童健康知識，陪伴家長安心育兒。</p>
      <div class="grid">
        {education.map((e) => (
          <a class="card" href={`/zh/education/${e.slug}/`}>
            <div class="media">
              {e.cover ? <img src={e.cover} alt="" loading="lazy" /> : <div class="ph" />}
              {e.tag && <span>{e.tag}</span>}
            </div>
            <div class="body">
              <h2>{e.title}</h2>
              {e.lead && <p>{e.lead}</p>}
              <div class="meta">
                {e.doctorName && <em>{e.doctorName}</em>}
                {e.date && <time>{e.date}</time>}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 56px 0 80px; }
  h1 { margin: 0; font-size: clamp(1.9rem, 4vw, 2.5rem); }
  .lead { margin: 12px 0 28px; color: var(--muted); font-size: 16px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card {
    background: #fff; border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .media { position: relative; aspect-ratio: 16 / 10; background: #eef3f5; }
  .media img, .ph { width: 100%; height: 100%; object-fit: cover; }
  .ph { background: linear-gradient(135deg, #e8f7f9, #f3f7f8); }
  .media span {
    position: absolute; left: 12px; bottom: 12px;
    display: inline-flex; padding: 4px 10px; border-radius: 999px;
    background: rgba(255,255,255,.94); color: var(--cyan-hover); font-size: 12px; font-weight: 600;
  }
  .body { padding: 16px 18px 18px; }
  .body h2 { margin: 0 0 8px; font-size: 17px; line-height: 1.4; }
  .body p {
    margin: 0;
    color: #555;
    font-size: 14px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    display: flex; flex-wrap: wrap; gap: 8px 12px;
    margin-top: 12px; color: var(--muted); font-size: 12px;
  }
  .meta em { font-style: normal; color: var(--cyan-hover); font-weight: 600; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .page { padding: 40px 0 56px; }
  }
</style>
