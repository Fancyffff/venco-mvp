---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import site from '../../../data/site.json';
---
<BaseLayout title={`兒科教育 | ${site.name}`}>
  <section class="page">
    <div class="container">
      <h1>兒科教育</h1>
      <p class="lead">分享實用兒童健康知識，陪伴家長安心育兒。</p>
      <div class="grid">
        {site.education.map((e) => (
          <article class="card">
            <div class="media">
              <img src={e.image} alt="" />
              <span>{e.tag}</span>
            </div>
            <div class="body">
              <h2>{e.title}</h2>
              <p>{e.excerpt}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 56px 0 80px; }
  h1 { margin: 0; font-size: clamp(1.9rem, 4vw, 2.5rem); }
  .lead { margin: 12px 0 28px; color: var(--muted); font-size: 16px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card {
    background: #fff; border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
  }
  .media { position: relative; aspect-ratio: 16 / 10; background: #eef3f5; }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .media span {
    position: absolute; left: 12px; bottom: 12px;
    display: inline-flex; padding: 4px 10px; border-radius: 999px;
    background: rgba(255,255,255,.94); color: var(--cyan-hover); font-size: 12px; font-weight: 600;
  }
  .body { padding: 16px 18px 18px; }
  .body h2 { margin: 0 0 8px; font-size: 17px; line-height: 1.4; }
  .body p { margin: 0; color: #555; font-size: 14px; line-height: 1.55; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .page { padding: 40px 0 56px; }
  }
</style>
