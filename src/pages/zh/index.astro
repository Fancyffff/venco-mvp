---
import BaseLayout from '../../layouts/BaseLayout.astro';
import services from '../../data/services.json';
import doctors from '../../data/doctors.json';
import site from '../../data/site.json';

const featuredDoctors = doctors.slice(0, 8);
---
<BaseLayout title={`${site.name}｜首頁`}>
  <section class="hero" style={`--hero:url(${site.homeHero})`}>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{site.name}<br />全面守護兒童成長</h1>
        {site.homeLead.map((p) => <p>{p}</p>)}
        <div class="hero-actions">
          <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
            <img src="/assets/whatsapp.svg" alt="" /> WhatsApp 預約
          </a>
          <a class="ghost" href="/zh/contact/">關於我們</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>全面的兒科服務</h2>
          <p>專業兒科服務，守護孩子健康成長</p>
        </div>
        <a class="text-link" href="/zh/services/">查看全部兒科服務 →</a>
      </div>
      <div class="service-grid">
        {services.map((s) => (
          <a class="service-card" href={`/zh/services/${s.id}/`}>
            <img src={s.icon} alt="" />
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span>了解更多</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>專業的醫生團隊</h2>
          <p>由經驗豐富的兒科醫生及專科團隊悉心照顧</p>
        </div>
        <a class="text-link" href="/zh/doctors/">查看全部醫生 →</a>
      </div>
      <div class="doctor-rail">
        {featuredDoctors.map((d) => (
          <a class="doctor-card" href={`/zh/doctors/#${d.id}`}>
            <img src={d.image} alt={d.name} />
            <div class="doctor-body">
              <h3>{d.name}</h3>
              <p class="en">{d.english}</p>
              <p class="title">{d.title}</p>
              {d.role && <p class="role">{d.role}</p>}
              <span>了解更多</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>豐富的兒科教育</h2>
          <p>分享實用兒童健康知識，陪伴家長安心育兒</p>
        </div>
        <a class="text-link" href="/zh/education/">查看全部兒科教育 →</a>
      </div>
      <div class="edu-grid">
        {site.education.map((e) => (
          <a class="edu-card" href={e.href}>
            <span class="tag">{e.tag}</span>
            <h3>{e.title}</h3>
            <p>{e.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>舒適的診所環境</h2>
          <p>溫馨童趣的診療空間，讓孩子安心接受照顧</p>
        </div>
        <a class="text-link" href="/zh/contact/">查看更多聯絡方式 →</a>
      </div>
      <div class="clinic-grid">
        {site.locations.map((loc) => (
          <article class="clinic-card">
            <img src={loc.mapImage} alt={`${loc.name}地圖`} />
            <div>
              <h3>{loc.name}</h3>
              <p>{loc.address}</p>
              <p>{loc.phone}</p>
              {loc.fax && <p>傳真 {loc.fax}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>馬上聯絡我們</h2>
        <p>我們的團隊隨時準備為您提供幫助</p>
      </div>
      <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
        <img src="/assets/whatsapp.svg" alt="" /> WhatsApp 預約
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    background:
      linear-gradient(90deg, rgba(255,255,255,.94) 0%, rgba(255,255,255,.55) 42%, rgba(255,255,255,.08) 70%),
      var(--hero) center right / cover no-repeat;
  }
  .hero-inner { width: 100%; padding: 56px 0; }
  .hero-copy { max-width: 560px; }
  .hero h1 {
    margin: 0;
    font-size: clamp(1.85rem, 5.5vw, 3.15rem);
    line-height: 1.15;
    letter-spacing: -.02em;
  }
  .hero p {
    margin: 14px 0 0;
    color: #333;
    line-height: 1.75;
    font-size: 15px;
  }
  .hero-actions { display: flex; gap: 12px; margin-top: 26px; flex-wrap: wrap; }
  .ghost {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0 18px; border-radius: 999px;
    background: rgba(255,255,255,.9); border: 1px solid var(--line);
    font-weight: 600; font-size: 14px;
  }

  .section { padding: 64px 0; }
  .section.soft { background: #f5fafb; }
  .section-head {
    display: flex; justify-content: space-between; align-items: end;
    gap: 16px; margin-bottom: 24px;
  }
  .section-head h2 { margin: 0; font-size: clamp(1.45rem, 3.5vw, 1.9rem); }
  .section-head p { margin: 8px 0 0; color: var(--muted); }
  .text-link { color: var(--cyan); font-weight: 600; white-space: nowrap; }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }
  .service-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 16px;
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .service-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .service-card img { width: 52px; height: 52px; object-fit: contain; margin-bottom: 12px; }
  .service-card h3 { margin: 0; font-size: 15px; }
  .service-card p { margin: 8px 0 14px; color: var(--muted); font-size: 13px; min-height: 40px; }
  .service-card span { color: var(--cyan); font-size: 13px; font-weight: 600; }

  .doctor-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 280px);
    gap: 14px;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
  }
  .doctor-card {
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }
  .doctor-card > img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #eef3f5;
  }
  .doctor-body { padding: 14px 16px 16px; }
  .doctor-body h3 { margin: 0; font-size: 17px; }
  .doctor-body .en { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
  .doctor-body .title { margin: 8px 0 0; color: var(--cyan-hover); font-weight: 600; font-size: 13px; }
  .doctor-body .role { margin: 4px 0 0; color: #555; font-size: 12px; }
  .doctor-body span { display: inline-block; margin-top: 12px; color: var(--cyan); font-size: 13px; font-weight: 600; }

  .edu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .edu-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px;
    min-height: 160px;
  }
  .edu-card .tag {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 999px;
    background: #e8f7f9;
    color: var(--cyan-hover);
    font-size: 12px;
    font-weight: 600;
  }
  .edu-card h3 { margin: 12px 0 8px; font-size: 16px; line-height: 1.4; }
  .edu-card p { margin: 0; color: var(--muted); font-size: 13px; }

  .clinic-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .clinic-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }
  .clinic-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    background: #eef3f5;
  }
  .clinic-card > div { padding: 16px; }
  .clinic-card h3 { margin: 0 0 8px; font-size: 18px; }
  .clinic-card p { margin: 4px 0; color: #444; font-size: 14px; }

  .cta-band {
    background: linear-gradient(90deg, #e7f9fb, #f3fcff);
    border-top: 1px solid var(--line);
    padding: 36px 0;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .cta-inner h2 { margin: 0; font-size: 1.5rem; }
  .cta-inner p { margin: 6px 0 0; color: var(--muted); }

  @media (max-width: 900px) {
    .edu-grid { grid-template-columns: 1fr; }
    .clinic-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .hero {
      min-height: auto;
      align-items: flex-end;
      background:
        linear-gradient(180deg, rgba(255,255,255,.2) 0%, rgba(255,255,255,.86) 55%, #fff 100%),
        var(--hero) 68% center / cover no-repeat;
    }
    .hero-inner { padding: 120px 0 24px; }
    .hero-copy {
      background: rgba(255,255,255,.94);
      border-radius: 18px;
      padding: 18px 16px;
      box-shadow: var(--shadow);
    }
    .hero p { font-size: 14px; }
    .hero-actions { gap: 8px; }
    .hero-actions .wa-btn,
    .hero-actions .ghost { flex: 1 1 auto; }
    .section { padding: 40px 0; }
    .section-head { flex-direction: column; align-items: start; gap: 8px; }
    .service-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .service-card { padding: 14px 12px; }
    .service-card p { display: none; }
    .cta-inner { flex-direction: column; align-items: stretch; }
    .cta-inner .wa-btn { width: 100%; }
  }
  @media (max-width: 380px) {
    .service-grid { grid-template-columns: 1fr; }
  }
</style>