---
import BaseLayout from '../../layouts/BaseLayout.astro';
import services from '../../data/services.json';
import doctors from '../../data/doctors.json';
import site from '../../data/site.json';
---
<BaseLayout title={`${site.name}｜首頁`}>
  <section class="hero" style={`background-image:linear-gradient(90deg,rgba(255,255,255,.92),rgba(255,255,255,.35)),url(${site.homeHero})`}>
    <div class="container hero-copy">
      <h1>{site.name}<br />全面守護兒童成長</h1>
      <p>榛怡醫務中心兒科專科，專注兒童健康診療。團隊由經驗豐富的兒科醫師組成，擅長診治小兒常見疾病、呼吸道、內分泌及敏感症的問題。</p>
      <div class="hero-actions">
        <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
          <img src="/assets/whatsapp.svg" alt="" /> WhatsApp 預約
        </a>
        <a class="ghost" href="/zh/contact/">關於我們</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>全面的兒科服務</h2>
          <p>從頂欄即可 L1→L2→L3 直達專科與細項</p>
        </div>
        <a class="text-link" href="/zh/services/">查看全部兒科服務 →</a>
      </div>
      <div class="service-grid">
        {services.map((s) => (
          <a class="service-card" href={`/zh/services/${s.id}/`}>
            <img src={s.icon} alt="" />
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span>了解更多</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>專業的醫生團隊</h2>
          <p>三級選單可直接跳到醫生詳情錨點</p>
        </div>
        <a class="text-link" href="/zh/doctors/">查看全部醫生 →</a>
      </div>
      <div class="doctor-grid">
        {doctors.slice(0, 6).map((d) => (
          <a class="doctor-card" href={`/zh/doctors/#${d.id}`}>
            <img src={d.image} alt={d.name} />
            <div>
              <h3>{d.name}</h3>
              <p>{d.title}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 520px;
    background-size: cover;
    background-position: center right;
    display: flex;
    align-items: center;
  }
  .hero-copy {
    max-width: 560px;
    padding: 64px 0;
    background: linear-gradient(90deg, rgba(255,255,255,.88) 0%, rgba(255,255,255,.72) 70%, transparent 100%);
    border-radius: 16px;
  }
  .hero h1 { margin: 0; font-size: clamp(1.75rem, 6vw, 3.2rem); line-height: 1.15; }
  .hero p { margin: 18px 0 0; color: #333; line-height: 1.7; }
  .hero-actions { display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap; }
  .ghost {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0 18px; border-radius: 999px;
    background: rgba(255,255,255,.85); border: 1px solid var(--line); font-weight: 600; font-size: 14px;
  }
  .section { padding: 56px 0; }
  .section.alt { background: #f7fbfc; }
  .section-head {
    display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 24px;
  }
  .section-head h2 { margin: 0; font-size: clamp(1.35rem, 4vw, 1.75rem); }
  .section-head p { margin: 8px 0 0; color: var(--muted); }
  .text-link { color: var(--cyan); font-weight: 600; white-space: nowrap; }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 12px;
  }
  .service-card {
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    padding: 16px; transition: transform .16s ease, box-shadow .16s ease;
  }
  .service-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .service-card img { width: 48px; height: 48px; object-fit: contain; margin-bottom: 12px; }
  .service-card h3 { margin: 0; font-size: 15px; }
  .service-card p { margin: 8px 0 12px; color: var(--muted); font-size: 13px; min-height: 0; }
  .service-card span { color: var(--cyan); font-size: 13px; font-weight: 600; }
  .doctor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }
  .doctor-card {
    display: flex; gap: 14px; align-items: center;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 14px;
  }
  .doctor-card img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
  .doctor-card h3 { margin: 0; font-size: 16px; }
  .doctor-card p { margin: 6px 0 0; color: var(--muted); font-size: 13px; }
  @media (max-width: 700px) {
    .hero {
      min-height: auto;
      background-position: 70% center;
      align-items: flex-end;
    }
    .hero-copy {
      width: 100%;
      max-width: none;
      margin: 28px 0 20px;
      padding: 18px 16px;
      background: rgba(255,255,255,.92);
      box-shadow: var(--shadow);
    }
    .hero p { font-size: 14px; }
    .hero-actions { gap: 8px; }
    .hero-actions .wa-btn,
    .hero-actions .ghost { flex: 1 1 auto; min-width: 140px; }
    .section { padding: 36px 0; }
    .section-head { flex-direction: column; align-items: start; gap: 8px; }
    .service-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .service-card p { display: none; }
  }
  @media (max-width: 380px) {
    .service-grid { grid-template-columns: 1fr; }
  }
</style>