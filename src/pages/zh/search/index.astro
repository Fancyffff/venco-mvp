---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import site from '../../../data/site.json';
import { buildSearchIndex } from '../../../lib/search';

const index = buildSearchIndex();
const initialQ = Astro.url.searchParams.get('q') || '';
---
<BaseLayout title={`搜尋 | ${site.name}`} description="搜尋兒科服務、醫生團隊與兒科教育內容。">
  <section class="page">
    <div class="container">
      <h1>搜尋</h1>
      <p class="lead">可搜尋專科服務、服務細項、醫生，以及兒科教育主題與文章。</p>

      <form class="search-form" action="/zh/search/" method="get" role="search">
        <label class="sr-only" for="q">搜尋關鍵字</label>
        <input
          id="q"
          name="q"
          type="search"
          value={initialQ}
          placeholder="例如：哮喘、劉家輝、鼻敏感、疫苗…"
          autocomplete="off"
          autofocus
          data-search-input
        />
        <button type="submit" class="wa-btn submit">搜尋</button>
      </form>

      <p class="status" data-search-status></p>
      <div class="results" data-search-results></div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ index, initialQ }}>
  const input = document.querySelector('[data-search-input]');
  const resultsEl = document.querySelector('[data-search-results]');
  const statusEl = document.querySelector('[data-search-status]');

  const typeOrder = ['service', 'service-item', 'doctor', 'education-topic', 'education', 'page'];

  function run(query) {
    const q = (query || '').trim().toLowerCase();
    if (!q) {
      statusEl.textContent = '輸入關鍵字後即可即時顯示結果。';
      resultsEl.innerHTML = '';
      return;
    }
    const tokens = q.split(/\s+/).filter(Boolean);
    const scored = [];
    for (const item of index) {
      const hay = `${item.title} ${item.subtitle || ''} ${item.keywords}`.toLowerCase();
      let score = 0;
      let miss = false;
      for (const t of tokens) {
        if (item.title.toLowerCase().includes(t)) score += 8;
        else if ((item.subtitle || '').toLowerCase().includes(t)) score += 4;
        else if (hay.includes(t)) score += 2;
        else { miss = true; break; }
      }
      if (miss) continue;
      if (item.title.toLowerCase().startsWith(tokens[0])) score += 3;
      scored.push({ item, score });
    }
    scored.sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title, 'zh-Hant'));
    const hits = scored.slice(0, 40).map((s) => s.item);

    statusEl.textContent = hits.length ? `找到 ${hits.length} 項結果` : '沒有符合的結果，可試試更短的關鍵字。';

    const groups = new Map();
    for (const item of hits) {
      if (!groups.has(item.typeLabel)) groups.set(item.typeLabel, []);
      groups.get(item.typeLabel).push(item);
    }

    // stable-ish group order
    const labels = [...groups.keys()].sort((a, b) => {
      const ia = hits.findIndex((h) => h.typeLabel === a);
      const ib = hits.findIndex((h) => h.typeLabel === b);
      return ia - ib;
    });

    resultsEl.innerHTML = labels.map((label) => {
      const list = groups.get(label).map((item) => `
        <a class="hit" href="${item.href}">
          <strong>${item.title}</strong>
          ${item.subtitle ? `<span>${item.subtitle}</span>` : ''}
        </a>
      `).join('');
      return `<section class="group"><h2>${label}</h2><div class="hits">${list}</div></section>`;
    }).join('');
  }

  let timer = 0;
  const syncUrl = (q) => {
    const url = new URL(window.location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  };

  input?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      const q = input.value;
      run(q);
      syncUrl(q.trim());
    }, 120);
  });

  document.querySelector('.search-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    run(input.value);
    syncUrl(input.value.trim());
  });

  run(initialQ);
</script>

<style>
  .page { padding: 56px 0 80px; }
  h1 { margin: 0; font-size: clamp(1.9rem, 4vw, 2.5rem); }
  .lead { margin: 12px 0 24px; color: var(--muted); max-width: 640px; line-height: 1.6; }
  .search-form {
    display: flex;
    gap: 10px;
    align-items: center;
    max-width: 720px;
  }
  .search-form input {
    flex: 1;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font-size: 16px;
    outline: none;
  }
  .search-form input:focus {
    border-color: var(--cyan);
    box-shadow: 0 0 0 3px rgba(0, 177, 195, 0.12);
  }
  .submit { flex: 0 0 auto; }
  .status {
    margin: 18px 0 8px;
    color: var(--muted);
    font-size: 14px;
    min-height: 1.2em;
  }
  .group { margin-top: 22px; }
  .group h2 {
    margin: 0 0 10px;
    font-size: 14px;
    color: var(--cyan-hover);
    letter-spacing: .02em;
  }
  .hits { display: grid; gap: 8px; }
  .hit {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .hit:hover { border-color: var(--cyan); box-shadow: var(--shadow); }
  .hit strong { font-size: 15px; line-height: 1.4; }
  .hit span { color: var(--muted); font-size: 13px; line-height: 1.45; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  @media (max-width: 700px) {
    .page { padding: 40px 0 56px; }
    .search-form { flex-direction: column; align-items: stretch; }
    .submit { width: 100%; }
  }
</style>
