---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import services from '../../../../data/services.json';
import doctors from '../../../../data/doctors.json';
import site from '../../../../data/site.json';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}

const { service } = Astro.props;
const doctorMap = Object.fromEntries(doctors.map((d) => [d.id, d]));
const related = service.doctorIds.map((id) => doctorMap[id]).filter(Boolean);
const siblings = services.filter((s) => s.id !== service.id).slice(0, 4);
---
<BaseLayout title={`${service.title} | ${site.name}`} description={service.desc}>
  <section class="crumb container">
    <a href="/zh/services/">兒科服務</a>
    <span>/</span>
    <strong>{service.title}</strong>
  </section>

  <section class="hero container">
    <img class="icon" src={service.icon} alt="" />
    <div>
      <p class="eyebrow">L2 專科頁 · 獨立路由</p>
      <h1>{service.title}</h1>
      <p>{service.desc}</p>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>服務細項 <span class="lvl">L3</span></h2>
      <p>每項獨立成頁，不再擠在總覽長頁裡。</p>
    </div>
    {service.items.length > 0 ? (
      <div class="items">
        {service.items.map((item) => (
          <a class="item" href={`/zh/services/${service.id}/${item.slug}/`}>
            <span class="dot" aria-hidden="true"></span>
            <div>
              <strong>{item.text}</strong>
              <small>打開 L3 詳情頁 →</small>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty">此專科暫無細項列表；可直接聯絡相關醫生預約。</div>
    )}
  </section>

  {related.length > 0 && (
    <section class="container block">
      <div class="block-head">
        <h2>相關醫生 <span class="lvl">L3</span></h2>
        <p>從專科頁直達醫生個人頁錨點。</p>
      </div>
      <div class="doctors">
        {related.map((d) => (
          <a class="doctor" href={`/zh/doctors/#${d.id}`}>
            <img src={d.image} alt={d.name} />
            <div>
              <strong>{d.name}</strong>
              <small>{d.title}</small>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="container cta">
    <a class="wa-btn" href={site.whatsapp} target="_blank" rel="noreferrer">
      <img src="/assets/whatsapp.svg" alt="" /> WhatsApp 預約
    </a>
    <a class="back" href="/zh/services/">← 返回服務總覽</a>
  </section>

  <section class="container more">
    <h2>其他專科</h2>
    <div class="more-grid">
      {siblings.map((s) => (
        <a href={`/zh/services/${s.id}/`}>
          <img src={s.icon} alt="" />
          <span>{s.title}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .crumb {
    display: flex; gap: 8px; align-items: center;
    padding: 24px 0 0; color: var(--muted); font-size: 13px;
  }
  .crumb a { color: var(--cyan); }
  .hero {
    display: grid; grid-template-columns: 72px 1fr; gap: 18px;
    padding: 28px 0 12px; align-items: start;
  }
  .icon { width: 72px; height: 72px; object-fit: contain; }
  .eyebrow {
    display: inline-flex; margin: 0 0 8px; padding: 4px 10px; border-radius: 999px;
    background: #111; color: #50dde4; font-size: 12px; font-weight: 700;
  }
  .hero h1 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .hero p { margin: 10px 0 0; color: #444; max-width: 640px; }
  .block { padding: 28px 0; }
  .block-head { margin-bottom: 14px; }
  .block-head h2 { margin: 0; font-size: 22px; display: flex; align-items: center; gap: 8px; }
  .block-head p { margin: 6px 0 0; color: var(--muted); font-size: 14px; }
  .lvl {
    display: inline-flex; padding: 1px 7px; border-radius: 999px;
    background: #111; color: #50dde4; font-size: 11px; font-weight: 700;
  }
  .items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 10px;
  }
  .item {
    display: flex; gap: 10px; align-items: start;
    padding: 16px; border-radius: 14px; background: #fff;
    border: 1px solid var(--line);
  }
  .item:hover { border-color: var(--cyan); box-shadow: var(--shadow); }
  .dot { width: 8px; height: 8px; margin-top: 7px; border-radius: 50%; background: var(--cyan); flex: 0 0 auto; }
  .item strong { display: block; font-size: 15px; }
  .item small { display: block; margin-top: 4px; color: var(--cyan); font-size: 12px; }
  .empty { padding: 16px; border-radius: 12px; background: #fff; border: 1px dashed var(--line); color: var(--muted); }
  .doctors {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .doctor {
    display: flex; gap: 12px; align-items: center;
    padding: 12px; background: #fff; border: 1px solid var(--line); border-radius: 14px;
  }
  .doctor img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
  .doctor strong { display: block; font-size: 14px; }
  .doctor small { color: var(--muted); font-size: 12px; }
  .cta { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; padding: 8px 0 36px; }
  .back { color: var(--cyan); font-weight: 600; }
  .more { padding-bottom: 64px; }
  .more h2 { margin: 0 0 14px; font-size: 18px; }
  .more-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
  .more-grid a {
    display: flex; gap: 10px; align-items: center;
    padding: 12px; background: #fff; border: 1px solid var(--line); border-radius: 12px; font-size: 14px;
  }
  .more-grid img { width: 32px; height: 32px; object-fit: contain; }
  @media (max-width: 700px) {
    .crumb { padding-top: 16px; font-size: 12px; flex-wrap: wrap; }
    .hero { grid-template-columns: 52px 1fr; gap: 12px; padding: 20px 0 8px; }
    .icon { width: 52px; height: 52px; }
    .hero h1 { font-size: 1.55rem; }
    .block { padding: 18px 0; }
    .items { grid-template-columns: 1fr; }
    .doctors { grid-template-columns: 1fr; }
    .more-grid { grid-template-columns: 1fr 1fr; }
    .cta { flex-direction: column; align-items: stretch; }
    .cta .wa-btn { width: 100%; }
  }
</style>