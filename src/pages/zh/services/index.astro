---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import services from '../../../data/services.json';
import site from '../../../data/site.json';
---
<BaseLayout title={`全面的兒科服務 | ${site.name}`} description="涵蓋診療、預防與健康管理，守護孩子成長。">
  <section class="page-hero" style={`background-image:linear-gradient(90deg,rgba(255,255,255,.92),rgba(255,255,255,.28)),url(${site.servicesHero})`}>
    <div class="container">
      <p class="eyebrow">L1 兒科服務</p>
      <h1>全面的兒科服務</h1>
      <p>每個專科獨立成頁（L2），細項再進第三層（L3）——不再把全部內容堆在同一頁。</p>
    </div>
  </section>

  <section class="container catalog">
    <div class="intro">
      <h2>選擇專科</h2>
      <p>共 {services.length} 個專科目錄，點進後只看該專科內容。</p>
    </div>
    <div class="grid">
      {services.map((s) => (
        <a class="card" href={`/zh/services/${s.id}/`}>
          <img src={s.icon} alt="" />
          <div>
            <span class="lvl">L2</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <em>
              {s.items.length > 0 ? `${s.items.length} 個細項` : '專科介紹'}
              {s.doctorIds.length > 0 ? ` · ${s.doctorIds.length} 位相關醫生` : ''}
              →
            </em>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 72px 0 56px;
    background-size: cover;
    background-position: center;
  }
  .eyebrow {
    display: inline-flex; margin: 0 0 10px; padding: 4px 10px; border-radius: 999px;
    background: #111; color: #50dde4; font-size: 12px; font-weight: 700;
  }
  .page-hero h1 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); }
  .page-hero p { margin: 12px 0 0; max-width: 620px; color: #333; }
  .catalog { padding: 40px 0 72px; }
  .intro { margin-bottom: 22px; }
  .intro h2 { margin: 0; font-size: 24px; }
  .intro p { margin: 8px 0 0; color: var(--muted); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .card {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
    padding: 18px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .card img { width: 56px; height: 56px; object-fit: contain; }
  .lvl {
    display: inline-flex; padding: 1px 7px; border-radius: 999px;
    background: #111; color: #50dde4; font-size: 10px; font-weight: 700;
  }
  .card h3 { margin: 6px 0 0; font-size: 18px; }
  .card p { margin: 8px 0; color: var(--muted); font-size: 14px; min-height: 40px; }
  .card em { font-style: normal; color: var(--cyan); font-size: 13px; font-weight: 600; }
</style>