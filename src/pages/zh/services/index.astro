---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import services from '../../../data/services.json';
import site from '../../../data/site.json';
---
<BaseLayout title={`全面的兒科服務 | ${site.name}`} description="涵蓋診療、預防與健康管理，守護孩子成長。">
  <section class="page-hero" style={`background-image:linear-gradient(90deg,rgba(255,255,255,.94),rgba(255,255,255,.35)),url(${site.servicesHero})`}>
    <div class="container">
      <h1>全面的兒科服務</h1>
      <p>涵蓋診療、預防與健康管理。選擇專科後可進一步查看服務細項與相關醫生。</p>
    </div>
  </section>

  <section class="container catalog">
    <div class="intro">
      <h2>選擇專科</h2>
      <p>共 {services.length} 個專科，點進後可查看該專科服務細項與醫生資訊。</p>
    </div>
    <div class="grid">
      {services.map((s) => (
        <a class="card" href={`/zh/services/${s.id}/`}>
          <img src={s.icon} alt="" />
          <div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <em>
              {s.items.length > 0 ? `${s.items.length} 個服務細項` : '專科介紹'}
              {s.doctorIds.length > 0 ? ` · ${s.doctorIds.length} 位相關醫生` : ''}
              →
            </em>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 80px 0 64px;
    background-size: cover;
    background-position: center right;
  }
  .page-hero h1 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); }
  .page-hero p { margin: 14px 0 0; max-width: 560px; color: #333; font-size: 16px; line-height: 1.7; }
  .catalog { padding: 48px 0 80px; }
  .intro { margin-bottom: 24px; }
  .intro h2 { margin: 0; font-size: 24px; }
  .intro p { margin: 8px 0 0; color: var(--muted); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }
  .card {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: #c5e4ea;
  }
  .card img { width: 56px; height: 56px; object-fit: contain; }
  .card h3 { margin: 0; font-size: 18px; }
  .card p { margin: 8px 0 12px; color: var(--muted); font-size: 14px; line-height: 1.5; min-height: 42px; }
  .card em { font-style: normal; color: var(--cyan); font-size: 13px; font-weight: 600; }
  @media (max-width: 700px) {
    .page-hero {
      padding: 44px 0 36px;
      background-position: 70% center;
      background-image: linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,.92)) !important;
    }
    .page-hero h1 { font-size: 1.75rem; }
    .page-hero p { font-size: 14px; }
    .catalog { padding: 28px 0 56px; }
    .grid { grid-template-columns: 1fr; gap: 10px; }
    .card {
      grid-template-columns: 44px 1fr;
      gap: 12px;
      padding: 16px;
    }
    .card img { width: 44px; height: 44px; }
    .card h3 { font-size: 16px; }
    .card p { min-height: 0; margin: 6px 0 10px; font-size: 13px; }
  }
</style>
